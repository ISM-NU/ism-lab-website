---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import PullBack from "../components/PullBack.astro";
import LightRuler from "../components/LightRuler.astro";
import FieldDots from "../components/FieldDots.astro";
import Archive from "../components/Archive.astro";
import ProjectCards from "../components/ProjectCards.astro";
import PaperList from "../components/PaperList.astro";
import { papers } from "../lib/pubs";

const latest = papers.filter((p) => p.group === "Papers").slice(0, 5);
const news = (await getCollection("news")).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const fmtDate = (d: Date) => d.toISOString().slice(0, 10).replaceAll("-", ".");
---

<Base title="Home" description="Dana Alina's interstellar medium group at Nazarbayev University measures magnetic fields in interstellar dust and gas, from Galactic molecular clouds to the Large Magellanic Cloud.">
  <Hero />
  <PullBack />

  <section class="sec" aria-labelledby="work-h">
    <div class="gut max">
      <div class="head">
        <h2 class="brut" id="work-h" data-scramble>Research lines</h2>
      </div>
      <ProjectCards />
    </div>
  </section>

  <FieldDots />

  <section class="sec" aria-labelledby="ours-h">
    <div class="gut max">
      <div class="head">
        <h2 class="brut" id="ours-h" data-scramble>Multi-band maps of our regions</h2>
        <p>Each composite combines dust and gas from Herschel, Spitzer, WISE and SHASSA H&alpha; with the plane-of-sky field orientation from Planck 353 GHz polarization. Hover over a map, or tap it, to show the field.</p>
      </div>
      <Archive />
    </div>
  </section>

  <LightRuler />

  <section class="sec" aria-labelledby="pub-h">
    <div class="gut max split">
      <div class="head">
        <h2 class="brut" id="pub-h">Latest papers</h2>
        <p><a href="/publications">All {papers.length} publications &rarr;</a></p>
      </div>
      <PaperList items={latest} dense />
    </div>
  </section>

  <section class="sec slab" aria-labelledby="news-h">
    <div class="gut max">
      <div class="head">
        <h2 class="brut" id="news-h">News and events</h2>
        <p><a href="/news">All news &rarr;</a></p>
      </div>
      <ul class="log-list">
        {news.map((n) => (
          <li>
            <span class="dot">{fmtDate(n.data.date)}</span>
            <span class={n.data.kind === "event" ? "tag fill" : "tag"}>{n.data.kind}</span>
            <a href={`/news#${n.id}`}>{n.data.title}</a>
            {n.data.mock && <span class="tag soon">Placeholder</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .split { display: grid; gap: 32px; }
  .log-list { list-style: none; margin: 32px 0 0; padding: 0; }
  .log-list li { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; padding: 16px 0; border-bottom: 1px solid color-mix(in srgb, currentColor 22%, transparent); }
  .log-list .dot { font-size: 18px; min-width: 9ch; }
  .log-list a { font-weight: 600; font-size: 18px; }
</style>
