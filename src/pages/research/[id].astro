---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import PaperList from "../../components/PaperList.astro";
import LayerLens from "../../components/LayerLens.astro";
import { byBibcode, type Paper } from "../../lib/pubs";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const items = p.data.papers.map((b) => byBibcode.get(b)).filter((x): x is Paper => !!x).sort((a, b) => b.year - a.year);
const missing = p.data.papers.filter((b) => !byBibcode.has(b));
if (missing.length) throw new Error(`${p.id}: bibcodes not in publications.json: ${missing.join(", ")}`);
---

<Base title={p.data.title} description={p.data.summary}>
  <PageHead label={`Research · ${p.data.code}`} title={p.data.title} intro={p.data.summary} image={p.data.image} caption={p.data.instruments.join(" · ")} />

  <section class="sec" style="padding-top:clamp(40px,6vw,80px)">
    <div class="gut max">
      <div class="prose"><Content /></div>
    </div>
  </section>

  {p.id === "lmc" && (
    <section class="sec tight" aria-labelledby="lens-h">
      <div class="gut max">
        <div class="head">
          <span class="label red">Instrument</span>
          <h2 class="brut" id="lens-h" data-scramble>Look through the layers</h2>
          <p>Every layer below is public survey data on one 12° grid. Swap the base, swap the lens, scrub through the hydrogen's velocity.</p>
        </div>
        <LayerLens />
      </div>
    </section>
  )}

  {p.data.upcoming.length > 0 && (
    <section class="sec tight" aria-labelledby="soon-h">
      <div class="gut max">
        <div class="head">
          <span class="label red">In progress</span>
          <h2 class="brut" id="soon-h">Coming soon</h2>
          <p>Results appear here once they are published.</p>
        </div>
        <div class="soon cells">
          {p.data.upcoming.map((u, i) => (
            <div>
              <span class="dot n">{String(i + 1).padStart(2, "0")}</span>
              <span class="tag soon rec">Coming soon</span>
              <h3 class="brut">{u.title}</h3>
              <p>{u.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="slab sec" aria-labelledby="papers-h">
    <div class="gut max">
      <div class="head">
        <span class="label">Published</span>
        <h2 class="brut" id="papers-h">Papers</h2>
        <p>{items.length} entries from NASA ADS. <a href="/publications">All publications &rarr;</a></p>
      </div>
      <div style="margin-top:32px"><PaperList items={items} /></div>
    </div>
  </section>
</Base>

<style>
  .soon { grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); margin-top: 40px; }
  .soon > div { padding: 22px 18px 26px; display: grid; gap: 12px; align-content: start; background-image: repeating-linear-gradient(-45deg, transparent 0 10px, rgba(243, 243, 239, 0.03) 10px 11px); }
  .soon .n { font-size: 34px; line-height: 1; color: var(--grey); }
  .soon .tag { justify-self: start; }
  .soon p { font-size: 13px; color: var(--grey); }
</style>
