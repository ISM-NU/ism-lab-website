---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import ProjectCards from "../../components/ProjectCards.astro";
import ResearchGraph from "../../components/ResearchGraph.astro";
import ScaleLadder from "../../components/ScaleLadder.astro";
---

<Base title="Research" description="Research lines of the ISM group: the Large Magellanic Cloud, interstellar filaments, star-forming clouds, polarized dust, optical polarimetry, hub-filament systems and machine learning.">
  <PageHead title="Research"
    intro="Whether magnetic fields guide gas into filaments and cores, and how they are organised across a galaxy."
    image="/sky/region-monoceros_ob1.webp" caption="Mon OB1 · Planck 353 GHz dust, field orientation as texture" />
  <section class="sec tight" style="padding-top: clamp(32px,6vw,64px)">
    <div class="gut max"><ProjectCards /></div>
  </section>
  <section class="slab sec" aria-labelledby="graph-h">
    <div class="gut max">
      <div class="head">
        <h2 class="brut" id="graph-h">Regions, instruments and methods</h2>
      </div>
      <ResearchGraph />
    </div>
  </section>
  <section class="slab sec" aria-labelledby="scale-h" style="padding-top: 0">
    <div class="gut max">
      <div class="head">
        <h2 class="brut" id="scale-h">Scales of the measurements</h2>
      </div>
      <ScaleLadder />
    </div>
  </section>
</Base>
