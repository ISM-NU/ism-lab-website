---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import ProjectCards from "../../components/ProjectCards.astro";
import ResearchGraph from "../../components/ResearchGraph.astro";
import ScaleLadder from "../../components/ScaleLadder.astro";
---

<Base title="Research" description="Research lines of the ISM group: the LMC magnetic field, filaments, star-forming clouds and dust polarization methods.">
  <PageHead title="Research"
    intro="The group measures magnetic fields in interstellar gas and dust, to find out whether they guide gas into filaments and cores and how they are organised across a galaxy."
    image="/sky/region-monoceros_ob1.webp" caption="Mon OB1 · Planck 353 GHz dust, field orientation as texture" />
  <section class="sec tight" style="padding-top:clamp(40px,6vw,80px)">
    <div class="gut max"><ProjectCards /></div>
  </section>
  <section class="slab sec" aria-labelledby="graph-h">
    <div class="gut max">
      <div class="head">
        <h2 class="brut" id="graph-h">Regions, instruments and methods</h2>
        <p>Each line cites the papers behind it. Select a node to list them.</p>
      </div>
      <ResearchGraph />
    </div>
  </section>
  <section class="slab sec" aria-labelledby="scale-h" style="padding-top:0">
    <div class="gut max">
      <div class="head">
        <h2 class="brut" id="scale-h">Scales of the measurements</h2>
        <p>Each bar runs from the beam to the size of the analysed map, at the distance adopted in the paper. Select one for the numbers.</p>
      </div>
      <ScaleLadder />
    </div>
  </section>
</Base>
