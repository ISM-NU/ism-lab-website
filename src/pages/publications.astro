---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import PaperList from "../components/PaperList.astro";
import { papers, papersOf, query, groups, isBig, instrumentNames, instrumentsOf, STELLAR, STELLAR_BIBCODES, BIG_COLLAB } from "../lib/pubs";

const slug = (s: string) => s.toLowerCase().replace(/[^a-z]+/g, "-");

// Research lines are the project pages' `papers` lists; the early stellar
// papers are their own line and stay out of the ISM groups below.
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const lineOf = new Map<string, string[]>();
for (const p of papers) {
  const hit = projects.filter((pr) => pr.data.papers.includes(p.bibcode)).map((pr) => pr.id);
  if (STELLAR_BIBCODES.has(p.bibcode)) hit.push(slug(STELLAR));
  lineOf.set(p.bibcode, hit.length ? hit : ["other"]);
}
const lines = [
  // Chips show the code from the research cards; the full name is the tooltip
  // and the accessible name.
  ...projects.map((pr) => ({ id: pr.id, label: pr.data.code, full: pr.data.title })),
  { id: slug(STELLAR), label: "Stellar", full: STELLAR },
  { id: "other", label: "Other", full: "Not in a research line" },
]
  .map((l) => ({ ...l, n: papers.filter((p) => lineOf.get(p.bibcode)!.includes(l.id)).length }))
  .filter((l) => l.n > 0);
const insts = instrumentNames
  .map((n) => ({ id: slug(n), label: n, n: papers.filter((p) => instrumentsOf(p).includes(n)).length }))
  .filter((i) => i.n > 0);
// Group members with at least one entry, PI first, for the member filter.
const people = (await getCollection("people")).sort((a, b) => a.data.order - b.data.order);
// Dana Alina is on every entry, so she gets no chip of her own.
const byMember = people
  .map((m) => ({ id: m.id, label: m.data.name.split(/\s+/).at(-1)!, full: m.data.name, list: papersOf(m.data.name) }))
  .filter((m) => m.list.length > 0 && m.list.length < papers.length);
const memberOf = new Map<string, string[]>();
for (const m of byMember) for (const p of m.list) memberOf.set(p.bibcode, [...(memberOf.get(p.bibcode) ?? []), m.id]);
const nFirst = papers.filter((p) => p.role === "first").length;
const nLed = papers.filter((p) => p.led).length;
const roles = [
  { id: "led", label: "Group-led", n: nLed },
  // Hidden while every group-led paper also has a member first author.
  ...(nFirst !== nLed ? [{ id: "first", label: "First author", n: nFirst }] : []),
  { id: "collab", label: "Collaboration", n: papers.length - nLed },
];

const early = papers.filter((p) => STELLAR_BIBCODES.has(p.bibcode));
const main = papers.filter((p) => !STELLAR_BIBCODES.has(p.bibcode));
const sections = [
  ...groups.map((g) => ({ id: slug(g), g, items: main.filter((p) => p.group === g) })),
  { id: slug(STELLAR), g: STELLAR, items: early },
].filter((s) => s.items.length);

// Citation split. Large collaborations are author lists of 100 or more.
const sum = (xs: typeof papers) => xs.reduce((a, p) => a + p.citations, 0);
const cites = sum(papers);
const citeLed = sum(papers.filter((p) => p.led));
const citeBig = sum(papers.filter(isBig));
const nBig = papers.filter(isBig).length;
const citeRest = cites - citeLed - citeBig;

const years = papers.map((p) => p.year);
const y0 = Math.min(...years), y1 = Math.max(...years);
const perYear = Array.from({ length: y1 - y0 + 1 }, (_, i) => {
  const y = y0 + i;
  const n = papers.filter((p) => p.year === y).length;
  return { y, n, led: papers.filter((p) => p.year === y && p.led).length };
});
const maxN = Math.max(...perYear.map((d) => d.n));
---

<Base title="Publications" description="Publications of the ISM group from NASA ADS, with filters by research line, instrument and role, and BibTeX.">
  <PageHead title="Publications" intro="From NASA ADS. Titles link to the journal version or arXiv.">
    <dl class="stats">
      <div><dt class="label">Entries</dt><dd class="dot">{papers.length}</dd></div>
      <div><dt class="label">Citations</dt><dd class="dot">{cites}</dd></div>
      <div><dt class="label">Years</dt><dd class="dot">{y0}–{y1}</dd></div>
    </dl>
    <p class="split">
      {citeLed} citations are to the {nLed} group-led entries, {citeBig} to {nBig} papers of large collaborations
      (author lists of {BIG_COLLAB} or more, among them the three Planck intermediate results), and {citeRest} to the other {papers.length - nLed - nBig} entries written with partners.
    </p>
  </PageHead>

  <section class="sec" style="padding-top: clamp(32px,5vw,64px)">
    <div class="gut max">
      <figure class="years" aria-label="Entries per year, group-led in red">
        {perYear.map((d) => (
          <div class="yb" title={`${d.y}: ${d.n} entries, ${d.led} group-led`}>
            {d.n > 0 && <b>{d.n}</b>}
            <div class="stack" style={`height:${(d.n / maxN) * 100}%`}>
              <i class="rest" style={`flex:${d.n - d.led}`}></i><i class="led" style={`flex:${d.led}`}></i>
            </div>
            <span>{d.y % 5 === 0 ? d.y : ""}</span>
          </div>
        ))}
      </figure>
      <p class="legend"><span><i class="sw led"></i>Group-led</span><span><i class="sw"></i>Other entries</span></p>
      <p class="fine">Group-led means a group member is first or last author.</p>

      <form class="filters" id="filters" aria-label="Filter publications">
        <fieldset data-key="line">
          <legend class="sr-only">Research line</legend>
          <span class="label" aria-hidden="true">Research line</span>
          <div class="chips">
            <button type="button" class="tag" data-v="" aria-pressed="true">All &middot; {papers.length}</button>
            {lines.map((l) => <button type="button" class="tag" data-v={l.id} aria-pressed="false" title={l.full} aria-label={`${l.full}, ${l.n}`}>{l.label} &middot; {l.n}</button>)}
          </div>
        </fieldset>
        <fieldset data-key="inst">
          <legend class="sr-only">Instrument or survey</legend>
          <span class="label" aria-hidden="true">Instrument</span>
          <div class="chips">
            <button type="button" class="tag" data-v="" aria-pressed="true">All</button>
            {insts.map((i) => <button type="button" class="tag" data-v={i.id} aria-pressed="false">{i.label} &middot; {i.n}</button>)}
          </div>
        </fieldset>
        <fieldset data-key="role">
          <legend class="sr-only">Role</legend>
          <span class="label" aria-hidden="true">Role</span>
          <div class="chips">
            <button type="button" class="tag" data-v="" aria-pressed="true">All</button>
            {roles.map((r) => <button type="button" class="tag" data-v={r.id} aria-pressed="false">{r.label} &middot; {r.n}</button>)}
          </div>
        </fieldset>
        {byMember.length > 0 && (
          <fieldset data-key="member">
            <legend class="sr-only">Group member</legend>
            <span class="label" aria-hidden="true">Member</span>
            <div class="chips">
              <button type="button" class="tag" data-v="" aria-pressed="true">All</button>
              {byMember.map((m) => <button type="button" class="tag" data-v={m.id} aria-pressed="false" title={m.full} aria-label={`${m.full}, ${m.list.length}`}>{m.label} &middot; {m.list.length}</button>)}
            </div>
          </fieldset>
        )}
        <p class="status" id="status" role="status" aria-live="polite">{papers.length} of {papers.length} entries</p>
      </form>
      <p class="fine">Instruments are matched from each title and abstract, so a paper that only uses a Planck-selected sample is also listed under Planck. Download all entries as <a href="/publications.bib" download>publications.bib</a>; author lists are cut at ten.</p>
    </div>
  </section>

  {sections.map((s, i) => (
    <section class:list={["sec", "grp", { slab: i === 0 }]} id={s.id} aria-labelledby={`${s.id}-h`} style="padding-block: clamp(48px,7vw,96px)">
      <div class="gut max">
        <div class="head">
          <h2 class="brut" id={`${s.id}-h`}>{s.g}</h2>
          <p><span class="count">{s.items.length}</span> entries{s.g === STELLAR && ". Spectropolarimetry of Sirius and Vega, before the move to interstellar magnetic fields."}</p>
        </div>
        <div style="margin-top: 24px"><PaperList items={s.items} meta lines={lineOf} members={memberOf} /></div>
      </div>
    </section>
  ))}

  <section class="sec tight">
    <div class="gut max"><p class="src">Source: NASA ADS, query <code>{query}</code>, keeping entries with Dana Alina or a member listed at Nazarbayev University; refreshed with scripts/fetch_publications.py. One-line results are quoted from the abstracts.</p></div>
  </section>
</Base>

<style>
  .stats { display: flex; flex-wrap: wrap; gap: 24px 48px; margin: 8px 0 0; }
  .stats div { display: grid; gap: 8px; }
  .stats dd { margin: 0; font-size: clamp(32px, 1rem + 2vw, 48px); line-height: 0.9; }
  .split { max-width: 62ch; font-size: 14px; color: var(--grey); margin: 0; }
  .years { margin: 16px 0 0; display: flex; align-items: end; gap: 4px; height: 120px; border-bottom: 1px solid var(--hair); }
  .yb { flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: end; position: relative; }
  .stack { display: flex; flex-direction: column; min-height: 1px; }
  .stack i { display: block; background: var(--ink); }
  .stack i.led { background: var(--signal); }
  .yb b { font: 600 12px/1 var(--mono); color: var(--grey); text-align: center; margin-bottom: 4px; font-variant-numeric: tabular-nums; }
  .yb span { position: absolute; top: 100%; left: 0; margin-top: 8px; font-size: 12px; color: var(--grey); }
  .legend { margin: 32px 0 8px; font: 400 12px/1.5 var(--mono); color: var(--grey); display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
  .sw { display: inline-block; width: 10px; height: 10px; background: var(--ink); }
  .sw.led { background: var(--signal); }
  .legend span { display: inline-flex; align-items: center; gap: 8px; margin-right: 16px; }
  /* One row per filter: the name in a fixed column, chips aligned to its right. */
  .filters { margin-top: 32px; display: grid; gap: 12px; border-top: 1px solid var(--hair); padding-top: 24px; }
  .filters fieldset { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 8px 16px; align-items: baseline; }
  .filters .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  @media (max-width: 640px) { .filters fieldset { grid-template-columns: minmax(0, 1fr); } }
  .filters .tag { background: none; color: var(--ink); cursor: pointer; font-family: var(--mono); white-space: normal; text-align: left; line-height: 1.3; }
  @media (hover: none) { .filters .tag { padding: 12px; } }
  .filters .tag:hover { background: var(--ink); color: var(--void); }
  .filters .tag[aria-pressed="true"] { background: var(--ink); color: var(--void); }
  .status { font: 600 12px/1 var(--mono); letter-spacing: 0.08em; color: var(--signal); margin: 8px 0 0; }
  .fine { font-size: 12px; color: var(--grey); max-width: 80ch; margin-top: 16px; }
  .src { font: 400 14px/1.5 var(--mono); color: var(--grey); }
</style>

<script>
  // Filters are plain attribute matches on the server-rendered list; one value per group.
  const form = document.getElementById("filters")!;
  const items = [...document.querySelectorAll<HTMLLIElement>("li[data-role]")];
  const groups = [...document.querySelectorAll<HTMLElement>(".grp")];
  const state: Record<string, string> = { line: "", inst: "", role: "", member: "" };
  const status = document.getElementById("status")!;
  function apply() {
    let shown = 0;
    for (const li of items) {
      const ok =
        (!state.line || li.dataset.line!.split(" ").includes(state.line)) &&
        (!state.inst || li.dataset.inst!.split(" ").includes(state.inst)) &&
        (!state.role || (state.role === "led" ? li.dataset.role !== "collab" : li.dataset.role === state.role)) &&
        (!state.member || li.dataset.member!.split(" ").includes(state.member));
      li.hidden = !ok;
      if (ok) shown++;
    }
    for (const g of groups) {
      const n = g.querySelectorAll("li:not([hidden])").length;
      g.hidden = n === 0;
      g.querySelector(".count")!.textContent = String(n);
    }
    status.textContent = `${shown} of ${items.length} entries`;
  }
  form.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-v]");
    if (!b) return;
    const set = b.closest<HTMLElement>("fieldset")!;
    state[set.dataset.key!] = b.dataset.v!;
    set.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    apply();
  });

  // BibTeX: the entry is cut out of /publications.bib on demand, so the page itself carries none.
  let bib: Promise<string> | null = null;
  document.addEventListener("click", async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-bib]");
    if (!b) return;
    bib ??= fetch("/publications.bib").then((r) => r.text());
    const entry = (await bib).split(/\n\n(?=@)/).find((x) => x.includes(`{${b.dataset.bib},`));
    if (!entry) return;
    await navigator.clipboard.writeText(entry);
    const t = b.textContent;
    b.textContent = "Copied";
    setTimeout(() => (b.textContent = t), 1500);
  });
</script>
