---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import PersonHead from "../components/PersonHead.astro";
import { alinaPapers } from "../lib/pubs";
import { initials, personHref, personLinks } from "../lib/people";

const people = (await getCollection("people")).sort((a, b) => a.data.order - b.data.order);
const names = people.map((p) => p.data.name);
const rendered = await Promise.all(people.map(async (p) => ({ p, Content: (await render(p)).Content })));
// The PI gets a lead block of her own; everyone else is listed below, current
// students first, then alumni. Each name opens the person's page.
const [lead, ...others] = rendered;
const groups = [
  { id: "students", title: "Students", list: others.filter(({ p }) => !p.data.alumni) },
  { id: "alumni", title: "Alumni", list: others.filter(({ p }) => p.data.alumni) },
].filter((g) => g.list.length > 0);
// Dana Alina's own record (entries she is an author on), not the whole group's.
const since = Math.min(...alinaPapers.map((p) => p.year));
const led = alinaPapers.filter((p) => p.led).length;
---

<Base title="People" description="The interstellar medium group at Nazarbayev University: Dana Alina, her students and alumni.">
  <!-- No title band: the nav marks the page and Dana Alina's block is its header. -->
  <h1 class="sr-only">People</h1>
  <PersonHead p={lead.p} initials={initials(lead.p.data.name, names)} href={personHref(lead.p.id)}>
    <lead.Content slot="bio" />
    <dl class="stats">
      <div><dt class="label">Entries in NASA ADS</dt><dd class="dot">{alinaPapers.length}</dd></div>
      <div><dt class="label">Group-led</dt><dd class="dot">{led}</dd></div>
      <div><dt class="label">Since</dt><dd class="dot">{since}</dd></div>
    </dl>
  </PersonHead>

  {groups.map((g) => (
  <section class="sec" aria-labelledby={`${g.id}-h`}>
    <div class="gut max">
      <div class="head">
        <h2 class="brut" id={`${g.id}-h`}>{g.title}</h2>
      </div>
      <ul class="people cells">
        {g.list.map(({ p, Content }) => (
          <li id={p.id} class="hover-clear">
            <Avatar photo={p.data.photo} initials={initials(p.data.name, names)} />
            <div class="meta">
              <span class="label">{p.data.role}</span>
              <h3 class="brut"><a class="open" href={personHref(p.id)}>{p.data.name}</a></h3>
              <span class="focus">{p.data.focus}</span>
              <div class="bio">{p.data.short ? <p>{p.data.short}</p> : <Content />}</div>
              <ul class="links">{personLinks(p).map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
  ))}
</Base>

<style>
  /* Hairlines drawn per card rather than by the grid gap, so a short last row
     leaves blank page instead of a grey hole. */
  .people { list-style: none; margin: 0; padding: 0; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 0; background: none; border-width: 1px 0 0 1px; }
  .people > li { position: relative; display: grid; grid-template-rows: auto 1fr; border: solid var(--hair); border-width: 0 1px 1px 0; }
  .meta { padding: 16px 16px 24px; display: grid; gap: 8px; align-content: start; border-top: 1px solid var(--hair); }
  .people h3 { font-size: clamp(24px, 1rem + 1vw, 32px); }
  /* The whole card opens the person's page through the name's link, stretched
     over the card; the email and profile links sit above it and stay separate. */
  .open { text-decoration: none; }
  .open::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .open:focus-visible { outline: none; }
  .people > li:has(.open:focus-visible) { outline: 2px solid var(--signal); outline-offset: -2px; }
  li:hover .open { text-decoration: underline; text-decoration-color: var(--signal); }
  .links { position: relative; z-index: 2; list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 12px; }
  .links a { overflow-wrap: anywhere; }
  .focus { font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; }
  .bio { font-size: 14px; color: var(--grey); }
  .bio :global(p) { margin: 0; }
  .stats { display: flex; flex-wrap: wrap; gap: 16px 32px; margin: 8px 0 0; }
  .stats div { display: grid; gap: 8px; }
  .stats dd { margin: 0; font-size: clamp(32px, 1rem + 2vw, 48px); line-height: 1; }
</style>
