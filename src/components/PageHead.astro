---
// Header band for inner pages: a big condensed title next to a framed sky
// image with its catalogue line, like a target readout.
import MapFrame from "./MapFrame.astro";
interface Props { title: string; intro?: string; image?: string; caption?: string }
const { title, intro, image, caption } = Astro.props;
---

<header class="ph gut">
  <div class="max grid">
    <div class="txt">
      <h1 class="brut page" data-scramble>{title}</h1>
      {intro && <p class="intro">{intro}</p>}
      <slot />
    </div>
    {image && (
      <figure class="frame">
        <MapFrame ids={[image]} compact><img src={image} alt="" decoding="async" fetchpriority="high" /></MapFrame>
        <span class="b tl"></span><span class="b tr"></span><span class="b bl"></span><span class="b br"></span>
        {caption && <figcaption class="label">{caption}</figcaption>}
      </figure>
    )}
  </div>
</header>

<style>
  .ph { padding-top: calc(var(--bar-h) + clamp(48px, 9vw, 128px)); padding-bottom: clamp(32px, 6vw, 64px); border-bottom: 1px solid var(--hair); }
  .grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); align-items: center; }
  .txt { display: grid; gap: 24px; }
  .intro { max-width: 52ch; font-size: 16px; }
  .frame { margin: 0; position: relative; aspect-ratio: 1; padding: 16px; }
  .frame img { width: 100%; height: 100%; object-fit: cover; }
  .b { position: absolute; width: 16px; height: 16px; border: 0 solid var(--signal); }
  .tl { top: 0; left: 0; border-width: 1px 0 0 1px; }
  .tr { top: 0; right: 0; border-width: 1px 1px 0 0; }
  .bl { bottom: 0; left: 0; border-width: 0 0 1px 1px; }
  .br { bottom: 0; right: 0; border-width: 0 1px 1px 0; }
  figcaption { position: absolute; left: 14px; bottom: -24px; color: var(--grey); }
  @media (max-width: 800px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .frame { max-width: 420px; }
  }
</style>
