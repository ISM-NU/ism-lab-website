---
// "Instrument" view of the LMC: one map as the base, a second seen through a
// lens that follows the pointer (the H I cube has its own viewer, CubeViewer).
// All layers sit on the same 12 deg grid, so they line up pixel for pixel.
import MapFrame from "./MapFrame.astro";
const layers = [
  { id: "comp", map: "comp-lmc", l: "Composite", src: "/sky/comp-lmc-1920.webp", note: "Herschel 250 µm cold dust (red), WISE 12 µm warm dust (teal), SHASSA H-alpha ionized gas (blue), WISE 3.4 µm stars" },
  { id: "field", map: "comp-lmc-field", l: "Field", src: "/sky/comp-lmc-field-1920.webp", note: "The composite with the Planck 353 GHz field orientation woven in" },
  { id: "fil", map: "comp-lmc-ridges", l: "Filaments", src: "/sky/comp-lmc-ridges-1920.webp", note: "Ridge filter on Herschel 250 µm: multiscale Hessian, the first step of a filament finder" },
  { id: "bfield", map: "lmc-bfield", l: "Planck", src: "/sky/lmc-bfield.webp", note: "Planck 353 GHz dust, textured along the field orientation" },
  { id: "dust", map: "lmc-dust", l: "Dust", src: "/sky/lmc-dust.webp", note: "Planck 353 GHz total intensity" },
  { id: "hi", map: "lmc-hi", l: "H I", src: "/sky/lmc-hi.webp", note: "GASS H I column density, 16' beam" },
  { id: "vel", map: "lmc-vel", l: "Velocity", src: "/sky/lmc-vel.webp", note: "GASS H I mean velocity, 200 (blue) to 320 km/s (red); the gradient across the disc is its rotation" },
  { id: "co", map: "lmc-co", l: "CO", src: "/sky/lmc-co.webp", note: "MAGMA CO(1-0), molecular clouds" },
  { id: "snr", map: "lmc-snr", l: "S/N", src: "/sky/lmc-snr.webp", note: "Signal to noise of the Planck 353 GHz polarized intensity after the smoothing used for the field texture; the red line is S/N = 3" },
];
---

<div class="lens-wrap">
  <div class="stage" id="lensStage" style="--x:50%;--y:50%">
    <MapFrame box="abs" ids={layers.map((l) => l.map)} active={[layers[0].map, layers[1].map]}>
      <img class="base" id="lensBase" src={layers[0].src} alt="LMC map, base layer" loading="lazy" decoding="async" />
      <img class="top" id="lensTop" src={layers[1].src} alt="" loading="lazy" decoding="async" />
    </MapFrame>
    <span class="ring" aria-hidden="true"></span>
    <span class="readout label" id="lensRead" aria-live="polite">Lens: {layers[1].l}</span>
  </div>
  <div class="ctl">
    <fieldset>
      <legend class="label">Base</legend>
      {layers.map((l, i) => <label><input type="radio" name="base" value={l.id} data-src={l.src} data-map={l.map} data-note={l.note} checked={i === 0} /><span>{l.l}</span></label>)}
    </fieldset>
    <fieldset>
      <legend class="label">Lens</legend>
      {layers.map((l, i) => <label><input type="radio" name="top" value={l.id} data-src={l.src} data-map={l.map} data-note={l.note} checked={i === 1} /><span>{l.l}</span></label>)}
    </fieldset>
    <p class="note" id="lensNote">{layers[1].note}. Point at or tap the map; the lens shows a second layer.</p>
  </div>
</div>

<style>
  .lens-wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 320px); gap: 24px; margin-top: 32px; }
  .stage { position: relative; aspect-ratio: 1; background: var(--void); overflow: hidden; touch-action: pan-y; cursor: crosshair; border: 1px solid var(--hair); }
  .stage img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .top { mask: radial-gradient(circle at var(--x) var(--y), #000 0 var(--r, 22%), transparent calc(var(--r, 22%) + 1px)); }
  .ring { position: absolute; left: var(--x); top: var(--y); width: calc(var(--r, 22%) * 2); aspect-ratio: 1; translate: -50% -50%; border: 1px solid var(--signal); border-radius: 50%; pointer-events: none; }
  .readout { position: absolute; left: 88px; top: 12px; color: var(--ink); background: rgba(0, 0, 0, 0.6); padding: 4px 8px; }
  .ctl { display: grid; gap: 24px; align-content: start; }
  fieldset { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  legend { margin-bottom: 8px; padding: 0; }
  fieldset label { cursor: pointer; }
  fieldset input { position: absolute; opacity: 0; pointer-events: none; }
  fieldset span { display: inline-block; padding: 8px 8px; border: 1px solid var(--hair); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; }
  fieldset input:checked + span { background: var(--ink); color: var(--void); border-color: var(--ink); }
  fieldset input:focus-visible + span { outline: 1px solid var(--signal); outline-offset: 2px; }
  .note { font-size: 12px; color: var(--grey); }
  @media (max-width: 800px) { .lens-wrap { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  const stage = document.getElementById("lensStage")!;
  const base = document.getElementById("lensBase") as HTMLImageElement;
  const top = document.getElementById("lensTop") as HTMLImageElement;
  const read = document.getElementById("lensRead")!;
  const note = document.getElementById("lensNote")!;
  // Image keys of the two visible layers; MapFrame shows their beams, colour bars and method.
  const checked = (n: string) => document.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)!.dataset.map!;
  const maps = [checked("base"), checked("top")];

  // A tap places the lens on touch screens; a sideways drag moves it there
  // too (touch-action: pan-y keeps vertical drags for scrolling the page).
  const move = (e: PointerEvent) => {
    const r = stage.getBoundingClientRect();
    stage.style.setProperty("--x", ((e.clientX - r.left) / r.width) * 100 + "%");
    stage.style.setProperty("--y", ((e.clientY - r.top) / r.height) * 100 + "%");
  };
  stage.addEventListener("pointermove", move);
  stage.addEventListener("pointerdown", move);
  document.querySelectorAll<HTMLInputElement>('.ctl input[type="radio"]').forEach((inp) =>
    inp.addEventListener("change", () => {
      const img = inp.name === "base" ? base : top;
      img.src = inp.dataset.src!;
      note.textContent = inp.dataset.note! + ".";
      maps[inp.name === "base" ? 0 : 1] = inp.dataset.map!;
      stage.querySelector(".mf")?.dispatchEvent(new CustomEvent("mf:set", { detail: maps }));
      if (inp.name === "top") read.textContent = "Lens: " + inp.parentElement!.textContent!.trim();
    }),
  );
</script>
