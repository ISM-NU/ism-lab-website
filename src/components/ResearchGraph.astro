---
// Regions, the data behind them and the methods, in three columns. Edges are
// drawn between columns (never through a label), each one citing its papers.
// Selecting a node lists the papers. On phones the columns stack into rows
// of chips and the lines are dropped; selection still works.
import { nodes, edges, nodePapers, type Kind } from "../data/graph";
import { byBibcode, titleHtml, authorLine, venue, link } from "../lib/pubs";

const cited = new Set([...edges.flatMap((e) => e.papers), ...Object.values(nodePapers).flat()]);
for (const b of cited) if (!byBibcode.has(b)) throw new Error(`ResearchGraph: bibcode ${b} is not in publications.json`);
const ids = new Set(nodes.map((n) => n.id));
for (const e of edges) if (!ids.has(e.a) || !ids.has(e.b)) throw new Error(`ResearchGraph: edge ${e.a}-${e.b} names an unknown node`);

const cols: [Kind, string][] = [["region", "Regions"], ["data", "Data"], ["method", "Methods"]];
const refs = Object.fromEntries([...cited].map((b) => {
  const p = byBibcode.get(b)!;
  return [b, { t: titleHtml(p.title), a: authorLine(p), y: p.year, v: venue(p), href: link(p) }];
}));
---

<div class="graph" id="graph">
  <svg class="lines" id="graphLines" aria-hidden="true"></svg>
  {cols.map(([k, title]) => (
    <div class={`col ${k}`}>
      <span class="label">{title}</span>
      <ul>
        {nodes.filter((n) => n.k === k).map((n) => (
          <li><button type="button" class="node" data-id={n.id} aria-pressed="false"><i></i><span>{n.l}</span></button></li>
        ))}
      </ul>
    </div>
  ))}
</div>
<div class="detail" id="graphNote" aria-live="polite">
  <p class="hint">Select a region, an instrument or a method to list the papers that connect them. Solid lines are published work; dashed lines are proposals or work in progress.</p>
</div>
<script type="application/json" id="graphData" set:html={JSON.stringify({ nodes, edges, nodePapers, refs })}></script>

<style>
  .graph { position: relative; margin-top: 32px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 clamp(48px, 10vw, 192px); }
  .lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .lines :global(path) { fill: none; stroke: rgba(10, 10, 11, 0.26); stroke-width: 1; transition: stroke 0.15s, opacity 0.15s; }
  .lines :global(path.soon) { stroke-dasharray: 4 4; }
  .lines :global(path.hot) { stroke: var(--signal); stroke-width: 1.8; }
  .lines :global(path.dim) { opacity: 0.25; }
  .col { display: grid; align-content: start; gap: 16px; }
  .col.data, .col.method { justify-items: start; }
  .col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .node { display: inline-flex; align-items: center; gap: 8px; background: none; border: 0; padding: 8px 0; cursor: pointer; color: var(--on-paper); text-align: left; min-height: 32px; }
  .node i { width: 8px; height: 8px; background: currentColor; flex: none; }
  .node span { font: 600 14px/1.15 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .region .node span { font: 800 clamp(18px, 0.9rem + 0.6vw, 24px)/1 var(--brut); font-stretch: 62%; letter-spacing: 0; text-transform: uppercase; }
  .region .node i { width: 11px; height: 11px; }
  .method .node i { border-radius: 50%; background: none; border: 1.5px solid currentColor; }
  .node:hover span { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: currentColor; }
  .node[aria-pressed="true"], .node.hot { color: #c4260f; }
  .graph.has-sel .node:not(.hot) { color: color-mix(in srgb, var(--on-paper) 40%, transparent); }

  .detail { margin-top: 32px; border-top: 1px solid rgba(10, 10, 11, 0.2); padding-top: 24px; min-height: 7em; max-width: 90ch; }
  .hint { font-size: 16px; color: var(--on-paper-dim); }
  .detail :global(h3) { font: 600 12px/1.3 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 12px; color: var(--on-paper-dim); }
  .detail :global(ol) { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .detail :global(li) { display: grid; gap: 4px; }
  .detail :global(.t) { font-weight: 600; font-size: 16px; }
  .detail :global(.m) { font: 400 14px/1.4 var(--mono); color: var(--on-paper-dim); }
  .detail :global(.soon) { font: 600 14px/1.4 var(--mono); color: #c4260f; }
  .detail :global(.more) { display: inline-block; margin-top: 16px; font: 600 12px/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; padding: 8px 0; }

  @media (max-width: 760px) {
    .graph { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .lines { display: none; }
    .col ul { display: flex; flex-wrap: wrap; gap: 4px 16px; }
  }
</style>

<script>
  type Ref = { t: string; a: string; y: number; v: string; href: string };
  type Data = {
    nodes: { id: string; l: string; k: string; href?: string }[];
    edges: { a: string; b: string; papers: string[]; soon?: string }[];
    nodePapers: Record<string, string[]>;
    refs: Record<string, Ref>;
  };
  const D: Data = JSON.parse(document.getElementById("graphData")!.textContent!);
  const graph = document.getElementById("graph")!;
  const svg = document.getElementById("graphLines")!;
  const note = document.getElementById("graphNote")!;
  const btn = new Map([...graph.querySelectorAll<HTMLButtonElement>(".node")].map((b) => [b.dataset.id!, b]));
  const order = ["region", "data", "method"];
  const kind = new Map(D.nodes.map((n) => [n.id, n.k]));
  let sel = "";

  // Curves run from the right edge of the left node's label to the marker
  // of the right node, so they never cross text.
  function draw() {
    if (getComputedStyle(svg).display === "none") return;
    const g = graph.getBoundingClientRect();
    svg.setAttribute("viewBox", `0 0 ${g.width} ${g.height}`);
    svg.innerHTML = D.edges.map((e, i) => {
      let [a, b] = [e.a, e.b];
      if (order.indexOf(kind.get(a)!) > order.indexOf(kind.get(b)!)) [a, b] = [b, a];
      const ra = btn.get(a)!.getBoundingClientRect(), rb = btn.get(b)!.querySelector("i")!.getBoundingClientRect();
      const x1 = ra.right - g.left + 8, y1 = ra.top + ra.height / 2 - g.top;
      const x2 = rb.left - g.left - 6, y2 = rb.top + rb.height / 2 - g.top;
      const mx = (x1 + x2) / 2;
      return `<path data-e="${i}" class="${e.soon ? "soon" : ""}" d="M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}" />`;
    }).join("");
    paint();
  }

  function paint() {
    const linked = new Set(sel ? [sel] : []);
    svg.querySelectorAll<SVGPathElement>("path").forEach((p) => {
      const e = D.edges[Number(p.dataset.e)];
      const on = !!sel && (e.a === sel || e.b === sel);
      p.classList.toggle("hot", on);
      p.classList.toggle("dim", !!sel && !on);
    });
    D.edges.forEach((e) => { if (sel && (e.a === sel || e.b === sel)) { linked.add(e.a); linked.add(e.b); } });
    graph.classList.toggle("has-sel", !!sel);
    btn.forEach((b, id) => { b.classList.toggle("hot", linked.has(id)); b.setAttribute("aria-pressed", String(id === sel)); });
  }

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  function show(id: string) {
    sel = id;
    paint();
    const n = D.nodes.find((x) => x.id === id)!;
    const mine = D.edges.filter((e) => e.a === id || e.b === id);
    const bibs = [...new Set([...mine.flatMap((e) => e.papers), ...(D.nodePapers[id] ?? [])])];
    bibs.sort((x, y) => D.refs[y].y - D.refs[x].y);
    const soon = mine.filter((e) => e.soon && !e.papers.length).map((e) => e.soon!);
    const items = bibs.map((b) => {
      const r = D.refs[b];
      return `<li><a class="t" href="${esc(r.href)}">${r.t}</a><span class="m">${esc(r.a)} · ${r.y} · ${esc(r.v)}</span>${mine.find((e) => e.soon && e.papers.includes(b)) ? `<span class="soon">${esc(mine.find((e) => e.papers.includes(b))!.soon!)}</span>` : ""}</li>`;
    });
    soon.forEach((s) => items.push(`<li><span class="soon">${esc(s)}</span></li>`));
    note.innerHTML = `<h3>${esc(n.l)} · ${bibs.length} ${bibs.length === 1 ? "paper" : "papers"}</h3><ol>${items.join("") || "<li><span class='m'>No published link yet.</span></li>"}</ol>` +
      (n.href ? `<a class="more" href="${n.href}">Open the research line →</a>` : "");
  }

  btn.forEach((b, id) => b.addEventListener("click", () => (sel === id ? (sel = "", paint(), (note.innerHTML = note.dataset.hint!)) : show(id))));
  note.dataset.hint = note.innerHTML;
  draw();
  new ResizeObserver(draw).observe(graph);
  document.fonts?.ready.then(draw);
</script>
