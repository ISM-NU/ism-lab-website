---
// Dot grid over the LMC. Near the pointer each dot becomes a dash along the
// plane-of-sky field orientation inferred from Planck 353 GHz polarization
// (angle + 90 deg, about 20' effective resolution, foreground included).
import maps from "../data/maps.json";
import MapFrame from "./MapFrame.astro";
const snr = maps.snr;
const lmc = maps.snr_stats.lmc8;
// Polarized S/N on the 96 x 96 field grid (scripts/map_meta.py), tenths. Dashes
// fade out below S/N 3 and the readout shows the value.
---

<section class="sec" aria-labelledby="field-h">
  <div class="gut max">
    <div class="head">
      <h2 class="brut" id="field-h" data-scramble>Field orientation in the LMC</h2>
      <p>A grid of dots over the LMC. Inside the lens each dot turns into a dash along the plane-of-sky field orientation, inferred from polarized dust emission. Point or tap to move the lens.</p>
    </div>
  </div>
  <div class="dotfield" id="dotfield">
    <MapFrame ids={["dotfield"]} box="abs" fill inset="62px">
      <canvas id="dotCanvas" role="img" aria-label="Dot grid that shows the LMC magnetic field direction inside a movable lens"></canvas>
    </MapFrame>
    <span class="label">Planck 353 GHz &middot; field PA &middot; foreground not removed &middot; S/N &gt; 3 over {Math.round(lmc.frac_gt3 * 100)}% of the grid</span>
    <script type="application/json" id="snrData" set:html={JSON.stringify(snr)}></script>
  </div>
</section>

<style>
  .dotfield { position: relative; height: min(88 * var(--svh, 1svh), 820px, 110vw); margin-top: 32px; border-top: 1px solid var(--hair); border-bottom: 1px solid var(--hair); overflow: hidden; touch-action: pan-y; }
  @media (hover: hover) { .dotfield { cursor: none; } }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .dotfield .label { position: absolute; left: var(--gut); bottom: 14px; }
</style>

<script>
  import { onFrame, watchVisible, canvasFit, loadImage, clamp, reduce } from "../scripts/motion";

  const box = document.getElementById("dotfield")!;
  const canvas = document.getElementById("dotCanvas") as HTMLCanvasElement;
  let ctx: CanvasRenderingContext2D, w = 0, h = 0, visible = false, dust: HTMLImageElement | null = null;
  const m = { x: 0, y: 0, t: -1e9, has: false, sy: 0 };
  // Touch screens have no pointer to follow. There the lens tours named
  // regions as the section scrolls past (on the 12 deg grid the dust map
  // shares), and a tap or a sideways drag moves it until the page has
  // scrolled a quarter screen on. It eases to each new place, and the canvas
  // is redrawn only when it moves.
  const touch = matchMedia("(hover: none)").matches;
  const TOUR = ["N79", "N11", "N44", "30 Doradus", "N159"];
  let tour: [string, number, number][] = [];
  let lx = -1, ly = -1, dirty = true;
  // F holds the field as an angle on the image grid (what the dashes need);
  // T is the grid angle of local north, so F - T is the position angle.
  // The field grid is most of sky.json (about 50 KB), so it is fetched when
  // the section comes near rather than bundled with the page script.
  let N = 0, F: number[] = [], TN = 0, T: number[] = [];
  const SN = JSON.parse(document.getElementById("snrData")!.textContent!) as { n: number; scale: number; min: number; grid: number[] };
  const snrAt = (u: number, v: number) => SN.grid[clamp(Math.floor(v * SN.n), 0, SN.n - 1) * SN.n + clamp(Math.floor(u * SN.n), 0, SN.n - 1)] / SN.scale;

  // The faint grid never changes, so it is drawn once per size into its own
  // layer; each frame only the cells under the lens are visited.
  let dots: HTMLCanvasElement | null = null;
  const stepOf = () => (w < 640 ? 13 : 16);
  function size() {
    w = box.clientWidth; h = box.clientHeight; ctx = canvasFit(canvas, w, h); dirty = true;
    dots = document.createElement("canvas");
    const d = canvasFit(dots, w, h), step = stepOf();
    d.fillStyle = "rgba(243,243,239,.22)";
    for (let y = step / 2; y < h; y += step) for (let x = step / 2; x < w; x += step) d.fillRect(x - 1, y - 1, 2, 2);
  }
  function setM(e: PointerEvent) { const r = box.getBoundingClientRect(); m.x = e.clientX - r.left; m.y = e.clientY - r.top; m.has = true; m.t = performance.now(); m.sy = scrollY; }
  box.addEventListener("pointermove", setM);
  box.addEventListener("pointerdown", setM);
  // A finger "leaves" as it lifts; the lens stays where it was tapped.
  box.addEventListener("pointerleave", (e) => { if (e.pointerType !== "touch") m.has = false; });
  const fieldAt = (u: number, v: number) => F[clamp(Math.floor(v * N), 0, N - 1) * N + clamp(Math.floor(u * N), 0, N - 1)];

  size();
  addEventListener("resize", size);
  let asked = false;
  watchVisible(box, (on) => {
    if (!on || asked) return;
    asked = true;
    loadImage("/sky/lmc-dust.webp").then((i) => { dust = i; dirty = true; });
    import("../data/sky.json").then(({ default: sky }) => {
      N = sky.field_n; F = sky.field; TN = sky.tilt_n; T = sky.north_tilt;
      const at: Record<string, number[]> = sky.lmc_targets;
      tour = TOUR.map((n) => [n, at[n][0], at[n][1]]);
    });
  }, "100%");
  watchVisible(box, (on) => (visible = on));
  // Dash styles come in LEVELS steps of strength, so each frame strokes one
  // path per step instead of one per dash.
  const LEVELS = 10;
  let lastDraw = -1e9, lastName = "";
  onFrame((t) => {
    if (!visible || !F.length || !dots) return;
    // 60 fps is plenty for a wandering lens; a 120-180 Hz screen would
    // otherwise redraw the whole field two or three times as often.
    if (t - lastDraw < 15) return;
    const side = Math.max(w, h), ox = (w - side) / 2, oy = (h - side) / 2;
    let mx = m.x, my = m.y, name = "";
    const held = m.has && (touch ? Math.abs(scrollY - m.sy) < innerHeight / 4 : performance.now() - m.t <= 2500);
    if (!held && touch && tour.length) {
      // Scroll tour: progress runs from the box entering the screen to it
      // leaving; the lens rests on each region for the middle half of its
      // share and moves between them in the rest.
      const r = box.getBoundingClientRect();
      const f = clamp(((innerHeight - r.top) / (innerHeight + r.height) - 0.15) / 0.7, 0, 1) * (tour.length - 1);
      const i = Math.min(tour.length - 2, Math.floor(f)), u = clamp((f - i - 0.25) / 0.5, 0, 1), e = u * u * (3 - 2 * u);
      const [a, b] = [tour[i], tour[i + 1]];
      mx = ox + (a[1] + (b[1] - a[1]) * e) * side;
      my = oy + (a[2] + (b[2] - a[2]) * e) * side;
      name = e === 0 ? a[0] : e === 1 ? b[0] : "";
    } else if (!held) {
      // Idle: the lens wanders on its own.
      const tt = (reduce ? 0 : t) / 1000;
      mx = w * (0.5 + 0.28 * Math.sin(tt * 0.45));
      my = h * (0.5 + 0.3 * Math.sin(tt * 0.7 + 1));
    }
    if (touch) {
      if (lx < 0 || reduce) [lx, ly] = [mx, my];
      else { lx += (mx - lx) * 0.2; ly += (my - ly) * 0.2; }
      if (!dirty && Math.abs(lx - mx) < 0.3 && Math.abs(ly - my) < 0.3 && name === lastName) return;
      [mx, my] = [lx, ly];
    }
    dirty = false;
    lastName = name;
    lastDraw = t;
    ctx.clearRect(0, 0, w, h);
    const R = Math.max(w < 640 ? 100 : 150, Math.min(w, h) * 0.3), step = stepOf();
    if (dust?.naturalWidth) {
      // Only the lens's square of the dust map, clipped to the circle.
      const r = R * 1.05, f = dust.naturalWidth / side;
      const x0 = Math.max(0, mx - r), y0 = Math.max(0, my - r), x1 = Math.min(w, mx + r), y1 = Math.min(h, my + r);
      if (x1 > x0 && y1 > y0) {
        ctx.save();
        ctx.beginPath();
        ctx.arc(mx, my, r, 0, Math.PI * 2);
        ctx.clip();
        ctx.globalAlpha = 0.5;
        ctx.drawImage(dust, (x0 - ox) * f, (y0 - oy) * f, (x1 - x0) * f, (y1 - y0) * f, x0, y0, x1 - x0, y1 - y0);
        ctx.restore();
      }
    }
    ctx.drawImage(dots, 0, 0, w, h);
    const paths = Array.from({ length: LEVELS }, () => new Path2D());
    const i0 = Math.max(0, Math.floor((mx - R) / step)), i1 = Math.ceil((mx + R) / step);
    const j0 = Math.max(0, Math.floor((my - R) / step)), j1 = Math.ceil((my + R) / step);
    for (let j = j0; j <= j1; j++) {
      const y = step / 2 + j * step;
      if (y >= h) break;
      for (let i = i0; i <= i1; i++) {
        const x = step / 2 + i * step;
        if (x >= w) break;
        const q0 = clamp(1 - Math.hypot(x - mx, y - my) / R, 0, 1);
        if (q0 <= 0) continue;
        // Below S/N 3 the direction is not trusted: the dash shrinks back to a dot (full strength at 3, none at 1).
        const sn = snrAt((x - ox) / side, (y - oy) / side);
        const q = q0 * clamp((sn - 1) / (SN.min - 1), 0, 1);
        if (q <= 0) continue;
        const a = fieldAt((x - ox) / side, (y - oy) / side), L = 2 + q * step * 0.9;
        const ex = (-Math.sin(a) * L) / 2, ey = (-Math.cos(a) * L) / 2;
        const path = paths[Math.min(LEVELS - 1, Math.floor(q * LEVELS))];
        path.moveTo(x - ex, y - ey);
        path.lineTo(x + ex, y + ey);
      }
    }
    for (let k = 0; k < LEVELS; k++) {
      const q = (k + 0.5) / LEVELS;
      ctx.strokeStyle = q > 0.55 ? `rgba(255,61,36,${0.5 + q * 0.5})` : `rgba(243,243,239,${0.35 + q * 0.6})`;
      ctx.lineWidth = 1 + q * 1.2;
      ctx.stroke(paths[k]);
    }
    ctx.strokeStyle = "rgba(255,61,36,.9)";
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.arc(mx, my, R, 0, Math.PI * 2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(mx - 10, my); ctx.lineTo(mx + 10, my); ctx.moveTo(mx, my - 10); ctx.lineTo(mx, my + 10); ctx.stroke();
    const tu = (mx - ox) / side, tv = (my - oy) / side;
    const tilt = T[clamp(Math.floor(tv * TN), 0, TN - 1) * TN + clamp(Math.floor(tu * TN), 0, TN - 1)];
    let a0 = ((fieldAt(tu, tv) - tilt) * 180) / Math.PI;
    a0 = ((a0 % 180) + 180) % 180;
    ctx.fillStyle = "#f3f3ef";
    ctx.font = "600 10px 'JetBrains Mono Variable', monospace";
    const txt = `B PA ${a0.toFixed(0)}° · S/N ${snrAt(tu, tv).toFixed(1)}`;
    const tx = Math.min(mx + R * 0.72 + 8, w - ctx.measureText(txt).width - 8), ty = Math.max(my - R * 0.72, name ? 30 : 16);
    ctx.fillText(txt, tx, ty);
    if (name) { ctx.fillStyle = "#ff3d24"; ctx.fillText(name.toUpperCase(), tx, ty - 14); }
  });
</script>
