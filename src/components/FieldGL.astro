---
// Live field view of the LMC drawn in the browser from Planck PR4 353 GHz
// Stokes Q and U (src/scripts/fieldgl.ts, data from scripts/render_stokes.py).
// Streaks are one smoothing FWHM long and fade where the polarized S/N drops
// below 5 (gone below 2). The scale control trades resolution for noise.
//
// view    "observed" or "subtracted" (Milky Way foreground removed)
// wipe    draggable split: observed left, subtracted right (ForegroundWipe)
// scale   initial smoothing FWHM in arcmin (one of stokes.json scales_arcmin)
// slot    overlays drawn over the map in a 1000 x 1000 box (e.g. contours)
import { stokes, sky } from "../lib/data";
import type { StokesMeta } from "../scripts/fieldgl";

interface Props { view?: "observed" | "subtracted"; wipe?: boolean; scale?: number; controls?: boolean; label?: string }
const { view = "observed", wipe = false, scale = 15, controls = true, label } = Astro.props;
const meta: StokesMeta = {
  beam_arcmin: stokes.beam_arcmin,
  scales_arcmin: stokes.scales_arcmin,
  planes: stokes.planes,
  i_stretch: stokes.i_stretch,
  mask_I: stokes.validation.site_grid.I_med,
  foreground: {
    p_fg: stokes.foreground.p_fg,
    psi_fg_grid_deg: stokes.foreground.psi_fg_grid_deg,
    sigma2_per_Ifg: stokes.foreground.sigma2_per_Ifg,
  },
};
const tilt = { n: sky.tilt_n, t: sky.north_tilt };
const GRID_ARCMIN = 1087 * 0.0111111 * 60;
const split = wipe ? 0.5 : view === "observed" ? 1 : 0;
const fmtScale = (s: number) => (s >= 60 ? `${s / 60}°` : `${s}′`);
// Compass near the top right; local north there is tilted by the projection.
const cu = 0.9, cv = 0.1;
const rotN = (tilt.t[Math.floor(cv * tilt.n) * tilt.n + Math.floor(cu * tilt.n)] * 180) / Math.PI;
const radioName = `fgl-scale-${Math.random().toString(36).slice(2, 7)}`;
const name = label ?? (wipe ? "LMC magnetic field, Planck as observed and after foreground subtraction" : view === "observed" ? "LMC magnetic field, Planck as observed" : "LMC magnetic field after foreground subtraction");
---

<figure class="fgl" data-split={split} data-scale={scale} data-wipe={wipe ? "" : undefined}>
  <div class="stage" style={`--split:${split * 100}%;--b:${(scale / GRID_ARCMIN) * 100}%`}>
    <canvas role="img" aria-label={`${name}. Streaks follow the plane-of-sky field orientation over 353 GHz dust emission.`}></canvas>
    <svg class="over" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true"><slot /></svg>
    <svg class="compass" width="50" height="50" viewBox="-25 -25 50 50" aria-hidden="true" style={`left:${cu * 100}%;top:${cv * 100}%`}>
      <g transform={`rotate(${(-rotN).toFixed(1)})`}>
        <path d="M0 0V-17M0 0H-17" />
        <text x="0" y="-19" text-anchor="middle">N</text>
        <text x="-21" y="4" text-anchor="end">E</text>
      </g>
    </svg>
    <span class="beam" aria-hidden="true"></span>
    <span class="beam-l label" aria-hidden="true">FWHM <b>{fmtScale(scale)}</b></span>
    {wipe && (
      <>
        <span class="side l label" aria-hidden="true">Planck as observed</span>
        <span class="side r label" aria-hidden="true">Foreground subtracted</span>
        <button class="handle" type="button" role="slider" aria-label="Wipe between the observed field and the field after foreground subtraction" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-valuetext="50% observed"><i></i></button>
      </>
    )}
    <span class="read label" aria-live="polite"></span>
    <noscript><span class="read label">The field view needs JavaScript.</span></noscript>
  </div>
  {controls && (
    <fieldset class="scales">
      <legend class="label">Smoothing</legend>
      {meta.scales_arcmin.map((s) => <label><input type="radio" name={radioName} value={s} checked={s === scale} /><span>{fmtScale(s)}</span></label>)}
      <p class="note">Larger beams average more noise away and blur the structure. Streaks fade where the polarized signal is under 5 times its noise and vanish under 2.</p>
    </fieldset>
  )}
</figure>
<script type="application/json" class="fgl-meta" set:html={JSON.stringify({ meta, tilt })}></script>

<style>
  /* The map stays inside the viewport height so the whole field is in view. */
  .fgl { margin: 0; display: grid; gap: 16px; width: min(100%, max(320px, calc(100 * var(--svh, 1svh) - 150px))); }
  .stage { position: relative; aspect-ratio: 1; background: var(--void); border: 1px solid var(--hair); overflow: hidden; touch-action: pan-y; cursor: crosshair; user-select: none; -webkit-user-select: none; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .over { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .compass { position: absolute; translate: -50% -50%; overflow: visible; pointer-events: none; }
  .compass path { stroke: var(--ink); stroke-width: 1.2; fill: none; }
  .compass text { fill: var(--ink); font: 600 12px var(--mono); }
  .beam { position: absolute; left: 4%; bottom: 4%; width: var(--b); aspect-ratio: 1; border: 1px solid var(--ink); border-radius: 50%; min-width: 4px; }
  .beam-l { position: absolute; left: calc(4% + max(var(--b), 4px) + 8px); bottom: calc(4% - 2px); color: var(--ink); background: rgba(0, 0, 0, 0.55); padding: 2px 4px; }
  .beam-l b { font-weight: 600; }
  /* No uppercase: it would turn sigma into Sigma. */
  .read { text-transform: none; position: absolute; left: 10px; top: 10px; color: var(--ink); background: rgba(0, 0, 0, 0.6); padding: 4px 8px; }
  .read:empty { display: none; }
  .side { position: absolute; bottom: 12%; color: var(--ink); background: rgba(0, 0, 0, 0.6); padding: 4px 8px; pointer-events: none; transition: opacity 0.2s; }
  .side.l { right: calc(100% - var(--split) + 14px); }
  .side.r { left: calc(var(--split) + 14px); }
  .handle { position: absolute; top: 0; bottom: 0; left: var(--split); width: 44px; translate: -50% 0; background: none; border: 0; padding: 0; cursor: ew-resize; touch-action: none; }
  .handle::before { content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: var(--ink); box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.5); }
  .handle i { position: absolute; left: 50%; top: 50%; width: 14px; height: 40px; translate: -50% -50%; background: var(--ink); border: 1px solid var(--void); }
  .handle:focus-visible { outline: none; }
  .handle:focus-visible i { outline: 1px solid var(--signal); outline-offset: 3px; }
  .scales { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .scales legend { margin-bottom: 8px; padding: 0; }
  .scales label { cursor: pointer; }
  .scales input { position: absolute; opacity: 0; pointer-events: none; }
  .scales span { display: inline-block; padding: 8px 12px; border: 1px solid var(--hair); font: 600 12px/1.2 var(--mono); letter-spacing: 0.06em; }
  .scales input:checked + span { background: var(--ink); color: var(--void); border-color: var(--ink); }
  .scales input:focus-visible + span { outline: 1px solid var(--signal); outline-offset: 2px; }
  .note { flex: 0 0 100%; font-size: 14px; color: var(--grey); margin-top: 8px; }
  @media (max-width: 520px) { .side { bottom: auto; top: 46px; } }
</style>

<script>
  import { FieldView, getStore, GRID_ARCMIN, type StokesMeta } from "../scripts/fieldgl";

  document.querySelectorAll<HTMLElement>(".fgl").forEach((fig) => {
    const { meta, tilt } = JSON.parse((fig.nextElementSibling as HTMLElement).textContent!) as { meta: StokesMeta; tilt: { n: number; t: number[] } };
    const stage = fig.querySelector<HTMLElement>(".stage")!;
    const canvas = stage.querySelector("canvas")!;
    const read = stage.querySelector<HTMLElement>(".read")!;
    const beamL = stage.querySelector<HTMLElement>(".beam-l b")!;
    const handle = stage.querySelector<HTMLButtonElement>(".handle");
    let split = +fig.dataset.split!;
    let scale = +fig.dataset.scale!;
    const view = new FieldView(canvas, getStore(meta), { scale, split });
    const fmt = (s: number) => (s >= 60 ? `${s / 60}°` : `${s}′`);

    fig.querySelectorAll<HTMLInputElement>(".scales input").forEach((inp) =>
      inp.addEventListener("change", () => {
        scale = +inp.value;
        view.set({ scale });
        stage.style.setProperty("--b", (scale / GRID_ARCMIN) * 100 + "%");
        beamL.textContent = fmt(scale);
      }),
    );

    // Readout: sky position angle of B (east of local north) and polarized S/N.
    const readAt = (e: PointerEvent) => {
      const r = stage.getBoundingClientRect();
      const u = (e.clientX - r.left) / r.width, v = (e.clientY - r.top) / r.height;
      const s = view.sample(u, v);
      if (!s) return;
      const t = tilt.t[Math.min(tilt.n - 1, Math.floor(v * tilt.n)) * tilt.n + Math.min(tilt.n - 1, Math.floor(u * tilt.n))];
      const pa = (((s.b - (t * 180) / Math.PI) % 180) + 180) % 180;
      read.textContent = s.snr < 2 ? `P/σ ${s.snr.toFixed(1)} · no reliable angle` : `B PA ${pa.toFixed(0)}° · P/σ ${s.snr.toFixed(0)}${handle ? (s.after ? " · subtracted" : " · observed") : ""}`;
    };
    stage.addEventListener("pointermove", (e) => { if (!dragging) readAt(e); });
    stage.addEventListener("pointerleave", () => (read.textContent = ""));

    // Wipe: drag the handle or anywhere on the map horizontally; arrow keys on the handle.
    let dragging = false;
    const setSplit = (x: number) => {
      split = Math.min(1, Math.max(0, x));
      stage.style.setProperty("--split", split * 100 + "%");
      view.set({ split });
      if (handle) {
        const pct = Math.round(split * 100);
        handle.setAttribute("aria-valuenow", String(pct));
        handle.setAttribute("aria-valuetext", `${pct}% observed`);
      }
    };
    if (handle) {
      const toX = (e: PointerEvent) => { const r = stage.getBoundingClientRect(); return (e.clientX - r.left) / r.width; };
      let startX = 0, startY = 0, armed = false;
      stage.addEventListener("pointerdown", (e) => {
        startX = e.clientX; startY = e.clientY; armed = true;
        if (e.target === handle || handle.contains(e.target as Node) || e.pointerType === "mouse") {
          dragging = true; stage.setPointerCapture(e.pointerId); setSplit(toX(e));
        }
      });
      stage.addEventListener("pointermove", (e) => {
        // On touch, only a mostly horizontal drag moves the wipe; vertical drags scroll the page.
        if (armed && !dragging && Math.abs(e.clientX - startX) > 8 && Math.abs(e.clientX - startX) > Math.abs(e.clientY - startY)) {
          dragging = true; stage.setPointerCapture(e.pointerId);
        }
        if (dragging) setSplit(toX(e));
      });
      const end = () => { dragging = false; armed = false; };
      stage.addEventListener("pointerup", end);
      stage.addEventListener("pointercancel", end);
      handle.addEventListener("keydown", (e) => {
        const step = e.shiftKey ? 0.1 : 0.02;
        const k = { ArrowLeft: -step, ArrowDown: -step, ArrowRight: step, ArrowUp: step } as Record<string, number>;
        if (e.key in k) setSplit(split + k[e.key]);
        else if (e.key === "Home") setSplit(0);
        else if (e.key === "End") setSplit(1);
        else if (e.key === "PageUp") setSplit(split + 0.1);
        else if (e.key === "PageDown") setSplit(split - 0.1);
        else return;
        e.preventDefault();
      });
    }
  });
</script>
