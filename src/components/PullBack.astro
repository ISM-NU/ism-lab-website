---
// Scroll-driven zoom out: the Tarantula -> the whole LMC -> the whole
// sky. World units are LMC widths; sizes and positions are real.
import sky from "../data/sky.json";
import { GRID_DEG, LY_PER_GRID, lyLabel } from "../lib/facts";
// Width of the Tarantula frame on the sky, from the fit described in the script.
const TAR_ARCSEC = 337;
const tarLy = Math.round((LY_PER_GRID * TAR_ARCSEC) / 3600 / GRID_DEG);
// Only these fields reach the browser. Importing sky.json in the script would
// load all of it (the field grid is about 50 KB) before the page is usable.
const pullData = { lmc_targets: sky.lmc_targets, lmc_in_allsky: sky.lmc_in_allsky, lmc_rot_deg: sky.lmc_rot_deg, tar_arcsec: TAR_ARCSEC };
---

<section class="pull" id="pull" aria-labelledby="pull-cap" data-console>
  <script type="application/json" id="pullData" set:html={JSON.stringify(pullData)} />
  <div class="stage" id="pullStage">
    <canvas id="pullCanvas" aria-hidden="true"></canvas>
    <div class="frame red" id="fT"><span>NGC 2070 &middot; JWST field &middot; {tarLy} ly</span></div>
    <div class="frame" id="fL"><span class="long">LMC field &middot; {Math.round(GRID_DEG)}&deg; &asymp; {lyLabel(LY_PER_GRID, 2)} ly</span><span class="short">LMC</span></div>
    <div id="tgts" aria-hidden="true"></div>
    <div class="hud">
      <div class="readout" aria-hidden="true"><span class="label red" id="rLabel">Field width</span><span class="dot" id="rVal">{tarLy} LY</span><span class="label" id="rSub">across the screen</span></div>
      <p class="cap" id="pull-cap" aria-live="polite">JWST NIRCam image of 30 Doradus (NGC 2070) and its central cluster, R136.</p>
    </div>
  </div>
</section>

<style>
  .pull { position: relative; height: calc(560 * var(--svh, 1svh)); }
  .stage { position: sticky; top: 0; height: calc(100 * var(--svh, 1svh)); overflow: hidden; background: var(--void); }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .frame { position: absolute; border: 1px solid var(--ink); pointer-events: none; transform-origin: 50% 50%; display: none; }
  .frame.red { border-color: var(--signal); box-shadow: 0 0 0 1px rgba(255, 61, 36, 0.25), 0 0 18px rgba(255, 61, 36, 0.35); }
  .frame span { position: absolute; left: -1px; bottom: 100%; padding: 4px 8px; font: 600 12px/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; background: var(--ink); color: var(--void); white-space: nowrap; }
  .frame.red span { background: var(--signal); }
  .frame.mini span { display: none; }
  /* Tall or short screens: the LMC frame's tag stays upright (the frame turns by
     101 deg on the way to the sky map) and shortens to "LMC" once the frame
     is narrower than the full tag. */
  #fL span { transform-origin: 0 100%; rotate: var(--unrot, 0rad); }
  #fL .short, #fL.small .long { display: none; }
  #fL.small .short { display: block; }
  /* Target markers: signal red with a dark outline, so they read on white
     nebula as well as on black. Each locks on when it appears (it switches
     from display none, which restarts the animations): the ring closes in,
     then the cross hairs grow and the name tag wipes in. */
  #tgts :global(.tgt) { position: absolute; width: 24px; height: 24px; translate: -50% -50%; border: 1.5px solid var(--signal); border-radius: 50%; pointer-events: none; display: none;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(0, 0, 0, 0.6), 0 0 12px rgba(255, 61, 36, 0.55);
    animation: tgt-ring 0.45s cubic-bezier(0.16, 1, 0.3, 1) both; }
  #tgts :global(.tgt)::before, #tgts :global(.tgt)::after { content: ""; position: absolute; background: var(--signal); box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.5); animation: tgt-hair 0.3s 0.18s cubic-bezier(0.16, 1, 0.3, 1) both; }
  #tgts :global(.tgt)::before { left: calc(50% - 0.75px); top: -8px; bottom: -8px; width: 1.5px; }
  #tgts :global(.tgt)::after { top: calc(50% - 0.75px); left: -8px; right: -8px; height: 1.5px; }
  /* .flip hangs the tag to the left of a marker near the right edge. */
  #tgts :global(.tgt.flip span) { left: auto; right: 24px; }
  #tgts :global(.tgt span) { position: absolute; left: 24px; top: -20px; padding: 4px 8px; background: var(--signal); color: var(--void); font: 600 12px/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap;
    animation: tgt-tag 0.28s 0.3s steps(6, end) both; }
  @keyframes tgt-ring { 0% { scale: 2.6; opacity: 0; } 50% { opacity: 1; } 100% { scale: 1; opacity: 1; } }
  @keyframes tgt-hair { from { scale: 0; } to { scale: 1; } }
  @keyframes tgt-tag { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @media (prefers-reduced-motion: reduce) { #tgts :global(.tgt), #tgts :global(.tgt)::before, #tgts :global(.tgt)::after, #tgts :global(.tgt span) { animation: none; } }
  .hud { position: absolute; inset: 0; pointer-events: none; display: grid; grid-template-rows: 1fr auto; padding: calc(var(--bar-h) + 24px + env(safe-area-inset-top, 0px)) var(--gut-r) calc(48px + env(safe-area-inset-bottom, 0px)) var(--gut); }
  .readout { justify-self: end; text-align: right; display: grid; gap: 4px; align-content: start; text-shadow: 0 0 8px #000, 0 0 16px #000; }
  .readout .label { color: var(--ink); }
  .readout .label.red { color: var(--signal); }
  .readout .dot { font-size: clamp(2rem, 1rem + 5vw, 6rem); line-height: 0.9; text-shadow: 0 0 16px #000; }
  /* On a dark plate: frame outlines and bright nebula pass under the caption. */
  .cap { max-width: 36ch; justify-self: start; font: 600 clamp(16px, 0.8rem + 0.5vw, 18px)/1.35 var(--mono); background: rgba(0, 0, 0, 0.72); padding: 8px 12px; margin-left: -12px; position: relative; z-index: 1; }
  /* Landscape phones: a smaller readout and caption leave the LMC in view. */
  @media (max-height: 500px) { .readout .dot { font-size: 48px; } .cap { max-width: 32ch; font-size: 14px; } }
</style>

<script>
  const { lmc_targets, lmc_in_allsky, lmc_rot_deg, tar_arcsec } = JSON.parse(document.getElementById("pullData")!.textContent!) as {
    lmc_targets: Record<string, [number, number]>; lmc_in_allsky: [number, number]; lmc_rot_deg: number; tar_arcsec: number };
  import { GRID_DEG, LY_PER_GRID } from "../lib/facts";
  import det from "../data/detections.json";
  import insets from "../data/zoom-insets.json";
  import { onFrame, canvasFit, clamp, seg, ease, fmt, reduce, watchVisible, tarantulaSrc, loadBitmap } from "../scripts/motion";

  const pull = document.getElementById("pull")!;
  const stage = document.getElementById("pullStage")!;
  const canvas = document.getElementById("pullCanvas") as HTMLCanvasElement;
  const fT = document.getElementById("fT")!, fL = document.getElementById("fL")!;
  const rVal = document.getElementById("rVal")!, rLabel = document.getElementById("rLabel")!, rSub = document.getElementById("rSub")!;
  const cap = document.getElementById("pull-cap")!;

  // World unit: the width of the LMC map grid.
  // The site shows ESA's centred 4:3 crop of the weic2212a NIRCam mosaic:
  // 11 224 of its 14 557 px. Fitting the mosaic to Spitzer IRAC 3.6 um gives
  // 0.0300"/px and north 13.5 deg left of vertical (294 Gaia DR3 stars agree
  // to 0.1 deg and 0.24"), so the crop spans tar_arcsec (ESA's "340
  // light-years" is the full mosaic). The image turns to north-up as the view
  // zooms out (TROT, about R136).
  const TW = tar_arcsec / 3600 / GRID_DEG, TH = TW * 0.75; // Tarantula frame as a share of the grid, 4:3
  const TROT = (13.5 * Math.PI) / 180;
  const FL = 0.0373; // LMC width as a fraction of the all-sky map width
  const T_C = lmc_targets["30 Doradus"];
  const SKY_LMC = lmc_in_allsky;
  const ROT = lmc_rot_deg;
  // R136 sits off the centre of the Webb frame; shift the frame so R136
  // lands on the 30 Dor position.
  const CORE = det.tarantula.core;
  const caps = [
    "JWST NIRCam image of 30 Doradus (NGC 2070) and its central cluster, R136.",
    "30 Doradus is the brightest star-forming region in the Large Magellanic Cloud.",
    "The LMC in public infrared and Hα surveys. Streaks trace the plane-of-sky field orientation from Planck 353 GHz polarization at about 25′, Milky Way foreground included.",
    "The LMC sits 33° below the Galactic plane. Streaks show the Milky Way's own field.",
  ];

  let ctx: CanvasRenderingContext2D, W = 0, H = 0, lastP = -1, capI = -1;
  type Img = ImageBitmap | HTMLImageElement;
  const wOf = (i?: Img) => (i ? ("naturalWidth" in i ? i.naturalWidth : i.width) : 0);
  const imgs: Record<string, Img> = {};
  // Finer renders around R136 (scripts/composites.py insets), placed in LMC
  // image fractions. Each fades in once the LMC image under it would be
  // magnified past its own pixels.
  const ins: { img?: Img; src: string; x: number; y: number; w: number }[] = insets.map((b) => ({ ...b }));
  const dpr = Math.min(devicePixelRatio || 1, 2);
  const tg = document.getElementById("tgts")!;
  const targets = Object.entries(lmc_targets).map(([name, pos]) => {
    const e = document.createElement("div");
    e.className = "tgt";
    const s = document.createElement("span");
    s.textContent = name;
    e.appendChild(s);
    tg.appendChild(e);
    return { e, pos, w: 0 };
  });

  function size() {
    W = stage.clientWidth;
    H = stage.clientHeight;
    ctx = canvasFit(canvas, W, H);
    lastP = -1;
  }

  function draw() {
    const r = pull.getBoundingClientRect();
    if (r.bottom < 0 || r.top > innerHeight) return;
    const p = clamp(-r.top / (r.height - H), 0, 1);
    if (p === lastP) return;
    lastP = p;
    const wide = W > H * 1.25;
    const skyW = 1 / FL, skyH = skyW / 2;
    const skyX = 0.5 - SKY_LMC[0] * skyW, skyY = 0.5 - SKY_LMC[1] * skyH;
    const k0 = Math.max(W / TW, H / TH);
    // On tall screens the disc is held wider than the screen: it fills only
    // the middle of the 12 deg field, so fitting the field left it small.
    const k1 = wide ? Math.min(W * 0.62, H * 0.98) : Math.min(W * 1.7, H * 0.95);
    // The whole sky fitted to a phone's width is a thin band in a black
    // screen. Tall screens end on about 130 deg of it instead, centred
    // between the LMC and the Galactic centre so both stay in view.
    const k2 = wide ? Math.min(W / skyW, H / skyH) * 0.96 : W / (skyW * 0.36);
    const c2 = wide ? [skyX + skyW / 2, skyY + skyH / 2] : [skyX + (skyW * (0.5 + SKY_LMC[0])) / 2, skyY + (skyH * (0.5 + SKY_LMC[1])) / 2];
    const c0 = [T_C[0] + TW * (0.5 - CORE[0]), T_C[1] + TH * (0.5 - CORE[1])], c1 = [0.5, 0.5];
    // Screen anchor of the view centre: the LMC sits left of the readout on
    // wide screens and below it on tall ones.
    const a0 = [W / 2, H / 2], a1 = wide ? [W * 0.42, H / 2] : [W / 2, H * 0.56];
    const e1 = ease(seg(p, 0.06, 0.46)), e2 = ease(seg(p, 0.6, 0.94));
    const rot = ((ROT * e2) * Math.PI) / 180;
    const lerp = (a: number[], b: number[], t: number) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
    let k: number, c: number[], an: number[];
    // The zoom is logarithmic, so the view centre is solved from the screen
    // path instead of interpolated in world units: the Tarantula (then the
    // LMC) moves in a straight line on screen and never leaves the view.
    if (p < 0.6) {
      k = Math.exp(Math.log(k0) + (Math.log(k1) - Math.log(k0)) * e1);
      an = lerp(a0, a1, e1);
      c = [c0[0] - (e1 * (c0[0] - c1[0]) * k1) / k, c0[1] - (e1 * (c0[1] - c1[1]) * k1) / k];
    } else {
      k = Math.exp(Math.log(k1) + (Math.log(k2) - Math.log(k1)) * e2);
      an = lerp(a1, a0, e2);
      c = [c1[0] - (e2 * (c1[0] - c2[0]) * k2) / k, c1[1] - (e2 * (c1[1] - c2[1]) * k2) / k];
    }
    const S = (wx: number, wy: number) => [(wx - c[0]) * k + an[0], (wy - c[1]) * k + an[1]];

    ctx.clearRect(0, 0, W, H);
    const aSky = p < 0.6 ? 0 : seg(e2, 0.02, 0.35);
    if (aSky > 0 && wOf(imgs.sky)) {
      const a = S(skyX, skyY);
      ctx.globalAlpha = aSky;
      ctx.drawImage(imgs.sky, a[0], a[1], skyW * k, skyH * k);
      ctx.globalAlpha = 1;
    }
    const lc = S(0.5, 0.5);
    ctx.save();
    ctx.translate(lc[0], lc[1]);
    ctx.rotate(rot);
    // Around the Webb frame the finest inset is 30 Dor's saturated core, a
    // pale wash that fills a tall screen above and below the 4:3 frame. There
    // the context comes in only as the frame shrinks from 70% to 20% of the
    // screen width, so the Webb image first reads as a window on black.
    const aL = p >= 0.6 ? 1 : wide ? seg(e1, 0.03, 0.22) : seg(1 - (TW * k) / W, 0.3, 0.8);
    // The viewport in this rotated frame, so only the visible part of each
    // image is drawn and deep zooms stay cheap.
    const cs0 = Math.cos(-rot), sn0 = Math.sin(-rot);
    const vx: number[] = [], vy: number[] = [];
    for (const [sx, sy] of [[0, 0], [W, 0], [0, H], [W, H]]) {
      const dx = sx - lc[0], dy = sy - lc[1];
      vx.push(dx * cs0 - dy * sn0);
      vy.push(dx * sn0 + dy * cs0);
    }
    const view = [Math.min(...vx) - 2, Math.min(...vy) - 2, Math.max(...vx) + 2, Math.max(...vy) + 2];
    const part = (im: Img, ox: number, oy: number, size: number) => {
      // Pad by two source pixels so the clamped edge of the cut stays off screen.
      const f = wOf(im) / size, pad = 2 / f;
      const x0 = Math.max(ox, view[0] - pad), y0 = Math.max(oy, view[1] - pad), x1 = Math.min(ox + size, view[2] + pad), y1 = Math.min(oy + size, view[3] + pad);
      if (x1 <= x0 || y1 <= y0) return;
      ctx.drawImage(im, (x0 - ox) * f, (y0 - oy) * f, (x1 - x0) * f, (y1 - y0) * f, x0, y0, x1 - x0, y1 - y0);
    };
    const L = imgs.lmc;
    if (aL > 0 && L && wOf(L)) {
      // The LMC and its insets are one layer: drawn opaque, then faded in as a
      // whole by a black veil (below p = 0.6 only black lies underneath).
      // Fading each image separately would add them up and brighten the stack.
      const layers: [Img, number, number, number, number][] = [[L, -k / 2, -k / 2, k, 1]];
      for (const b of ins) {
        const a = wOf(b.img) ? seg((k * dpr) / wOf(L), 1, 1.6) : 0;
        if (a > 0) layers.push([b.img!, (b.x - 0.5) * k, (b.y - 0.5) * k, b.w * k, a]);
      }
      // Skip whatever lies under an opaque inset that fills the view: each
      // layer is a full-screen blend, and fill rate is the cost on big screens.
      // EDGE is the feathered border baked into the inset images.
      const EDGE = 0.12;
      let from = 0;
      layers.forEach(([, ox, oy, s, a], j) => {
        const e = s * EDGE;
        if (a >= 1 && ox + e <= view[0] && oy + e <= view[1] && ox + s - e >= view[2] && oy + s - e >= view[3]) from = j;
      });
      const draw = layers.slice(from);
      // A single layer takes the fade itself; a stack needs the veil.
      const one = draw.length === 1;
      for (const [im, ox, oy, s, a] of draw) {
        ctx.globalAlpha = one ? a * aL : a;
        part(im, ox, oy, s);
      }
      ctx.globalAlpha = 1;
      if (!one && aL < 1) {
        ctx.fillStyle = `rgba(0,0,0,${1 - aL})`;
        ctx.fillRect(view[0], view[1], view[2] - view[0], view[3] - view[1]);
      }
    }
    const tr = TROT * e1;
    if (wOf(imgs.tar)) {
      ctx.save();
      ctx.translate((T_C[0] - 0.5) * k, (T_C[1] - 0.5) * k);
      ctx.rotate(tr);
      ctx.drawImage(imgs.tar, -TW * CORE[0] * k, -TH * CORE[1] * k, TW * k, TH * k);
      ctx.restore();
    }
    ctx.restore();

    // Frame centre: the image centre, turned by tr about R136, then by rot about the LMC centre.
    const ox = TW * (0.5 - CORE[0]), oy = TH * (0.5 - CORE[1]);
    const tw = TW * k, th = TH * k, tc = S(T_C[0] + ox * Math.cos(tr) - oy * Math.sin(tr), T_C[1] + ox * Math.sin(tr) + oy * Math.cos(tr));
    const dx = tc[0] - lc[0], dy = tc[1] - lc[1], cs = Math.cos(rot), sn = Math.sin(rot);
    const tcx = lc[0] + dx * cs - dy * sn, tcy = lc[1] + dx * sn + dy * cs;
    const showT = tw < W * 0.85 && tw > 6;
    fT.style.display = showT ? "block" : "none";
    if (showT) {
      Object.assign(fT.style, { left: tcx - tw / 2 + "px", top: tcy - th / 2 + "px", width: tw + "px", height: th + "px", rotate: rot + tr + "rad" });
      // A narrow screen has no room for the tag beside a small frame.
      fT.classList.toggle("mini", (tw < 90 && p > 0.3 && p < 0.62) || (!wide && tcx - tw / 2 + 290 > W));
    }
    const showL = p > 0.62 && k < W * 0.8;
    fL.style.display = showL ? "block" : "none";
    if (showL) {
      Object.assign(fL.style, { left: lc[0] - k / 2 + "px", top: lc[1] - k / 2 + "px", width: k + "px", height: k + "px", rotate: rot + "rad" });
      // Upright where a turned tag would run off the screen: tall or short screens.
      const upright = !wide || H < 560;
      fL.style.setProperty("--unrot", upright ? -rot + "rad" : "0rad");
      fL.classList.toggle("small", upright && k < 280);
    }
    const showTg = p > 0.44 && p < 0.62;
    targets.forEach((t, i) => {
      const on = showTg && (reduce || seg(p, 0.44, 0.5) * targets.length > i);
      t.e.style.display = on ? "block" : "none";
      if (on) {
        const q = S(t.pos[0], t.pos[1]);
        t.e.style.left = q[0] + "px";
        t.e.style.top = q[1] + "px";
        t.w ||= (t.e.firstElementChild as HTMLElement).offsetWidth;
        t.e.classList.toggle("flip", q[0] + 24 + t.w > W - 8);
      }
    });

    const widthL = W / k;
    if (p < 0.6) { rLabel.textContent = "Field width"; rVal.textContent = fmt(widthL * LY_PER_GRID) + " LY"; rSub.textContent = "across the screen"; }
    else {
      const deg = widthL * GRID_DEG;
      rLabel.textContent = "Field of view";
      rVal.textContent = deg > 300 ? "360°" : (deg >= 100 ? Math.round(deg) : deg.toFixed(1)) + "°";
      rSub.textContent = deg > 300 ? "the whole sky" : "of sky";
    }
    const ci = p < 0.22 ? 0 : p < 0.44 ? 1 : p < 0.66 ? 2 : 3;
    if (ci !== capI) { capI = ci; cap.textContent = caps[ci]; }
  }

  size();
  addEventListener("resize", size);
  // The zoom sits right under the hero, so a "near" margin would fire at
  // once and compete with the hero image. Load on the first scroll into it
  // instead: the finest inset first (it is on screen first), the all-sky map
  // last. The Tarantula is the hero's image, already in the cache.
  let asked = false;
  watchVisible(pull, (on) => {
    if (!on || asked) return;
    asked = true;
    const big = W * dpr > 1400;
    [...ins].reverse().forEach((b) => loadBitmap(`${b.src}-${big ? 2048 : 1024}.webp`).then((i) => { b.img = i; lastP = -1; }));
    loadBitmap(big ? "/sky/comp-lmc-field-v-2048.webp" : "/sky/comp-lmc-field-v-1400.webp").then((i) => { imgs.lmc = i; lastP = -1; });
    loadBitmap("/sky/allsky.webp").then((i) => { imgs.sky = i; lastP = -1; });
  }, "0px 0px -2px 0px"); // its top edge touches the viewport at load
  loadBitmap(tarantulaSrc()).then((i) => { imgs.tar = i; lastP = -1; });
  onFrame(draw);
</script>
