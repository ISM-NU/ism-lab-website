---
// Home hero: the Webb Tarantula image assembles tile by tile while the source
// finder's boxes snap on, then a lock settles on R136.
---

<header class="hero" id="hero" data-console>
  <canvas id="heroCanvas" role="img" aria-label="James Webb Space Telescope image of the Tarantula Nebula in the Large Magellanic Cloud, with its brightest compact sources boxed"></canvas>
  <noscript><img src="/webb/tarantula-1920.webp" alt="" class="hero-fallback" /></noscript>
  <div class="dets" id="heroDets"></div>
  <div class="hero-copy gut">
    <h1 class="brut">Interstellar<br />medium group</h1>
    <div class="who">
      <p>Led by <a href="/people#dana-alina">Dana Alina</a> at Nazarbayev University, Astana. The group measures magnetic fields in interstellar dust and gas, from Galactic molecular clouds to the Large Magellanic Cloud.</p>
      <p class="links"><a href="/research">Research</a><a href="/publications">Publications</a><a href="/join">Join or visit</a></p>
    </div>
    <p class="credit label">30 Doradus, LMC &middot; JWST NIRCam, ESA/Webb</p>
  </div>
</header>

<style>
  .hero { position: relative; height: 100svh; min-height: 560px; overflow: hidden; background: var(--void); }
  .hero canvas, .hero-fallback { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Darken the strip under the fixed nav so its difference-blended text stays legible over bright nebula. */
  .hero::after { content: ""; position: absolute; inset: 0 0 auto; height: 110px; background: linear-gradient(rgba(0, 0, 0, 0.6), transparent); pointer-events: none; }
  .dets { position: absolute; inset: 0; pointer-events: none; }
  .hero-copy { position: absolute; left: 0; right: 0; bottom: 0; padding-bottom: calc(48px + env(safe-area-inset-bottom, 0px)); display: grid; gap: 24px; pointer-events: none; z-index: 1; }
  /* Readability scrim under the copy: the nebula is brightest at the bottom left. */
  .hero-copy::before { content: ""; position: absolute; inset: -30% 0 0; background: linear-gradient(transparent, rgba(0, 0, 0, 0.55) 45%, rgba(0, 0, 0, 0.75)); z-index: -1; }
  .who { display: grid; gap: 16px; max-width: 58ch; pointer-events: auto; }
  .who p { font-size: clamp(16px, 0.9rem + 0.35vw, 18px); line-height: 1.45; text-shadow: 0 0 12px #000; }
  .links { display: flex; flex-wrap: wrap; gap: 12px 24px; font: 600 12px/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .links a { padding: 12px 0; text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 6px; }
  h1 { font-size: clamp(48px, 2rem + 6vw, 128px); text-shadow: 0 0 40px rgba(0, 0, 0, 0.55); }
  .who a:not(.links a) { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 4px; }
  .credit { color: var(--ink); text-shadow: 0 0 8px #000; justify-self: end; opacity: 0.8; }
  @media (max-width: 640px) { .who p { font-size: 16px; } .credit { justify-self: start; } }
</style>

<script>
  import det from "../data/detections.json";
  import { reduce, canvasFit, loadImage, clamp, scramble, tarantulaSrc } from "../scripts/motion";

  const hero = document.getElementById("hero")!;
  const canvas = document.getElementById("heroCanvas") as HTMLCanvasElement;
  const box = document.getElementById("heroDets")!;
  const T = det.tarantula;
  type Rect = { x: number; y: number; w: number; h: number };
  let img: HTMLImageElement, rect: Rect, ctx: CanvasRenderingContext2D;
  let tiles: [number, number, number][] = [];
  let revealed = 0;

  function cover(iw: number, ih: number, w: number, h: number): Rect {
    const s = Math.max(w / iw, h / ih);
    return { x: (w - iw * s) / 2, y: (h - ih * s) / 2, w: iw * s, h: ih * s };
  }
  function place(el: HTMLElement, n: number[]) {
    el.style.left = rect.x + n[0] * rect.w + "px";
    el.style.top = rect.y + n[1] * rect.h + "px";
    const s = Math.max(10, n[2] * rect.w * 2.2);
    el.style.width = el.style.height = s + "px";
  }
  function size() {
    const w = hero.clientWidth, h = hero.clientHeight;
    ctx = canvasFit(canvas, w, h);
    rect = cover(img.naturalWidth, img.naturalHeight, w, h);
    const t = w < 640 ? 28 : 40;
    tiles = [];
    for (let y = 0; y < h; y += t) for (let x = 0; x < w; x += t) tiles.push([x, y, t]);
    for (let i = tiles.length - 1; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; [tiles[i], tiles[j]] = [tiles[j], tiles[i]]; }
    ctx.fillStyle = "#000";
    ctx.fillRect(0, 0, w, h);
    if (revealed >= 1) ctx.drawImage(img, rect.x, rect.y, rect.w, rect.h);
    const kids = box.children;
    T.src.forEach((n, i) => kids[i] && place(kids[i] as HTMLElement, n));
    const lock = document.getElementById("lock");
    if (lock) place(lock, [T.core[0], T.core[1], 0.035]);
  }
  function tile([x, y, t]: [number, number, number]) {
    const k = img.naturalWidth / rect.w;
    ctx.drawImage(img, (x - rect.x) * k, (y - rect.y) * k, t * k, t * k, x, y, t, t);
  }

  function detections(instant: boolean) {
    box.textContent = "";
    T.src.forEach((n, i) => {
      const b = document.createElement("div");
      b.className = "det";
      // Boxes only: the finder's score is a brightness rank on the 8-bit press
      // image, not a measurement, so it is not printed.
      if (i >= (hero.clientWidth < 700 ? 24 : 70)) return;
      place(b, n);
      if (!instant) { b.style.opacity = "0"; setTimeout(() => { b.style.opacity = ""; b.classList.add("pop"); }, 700 + i * 16); }
      box.appendChild(b);
    });
    const L = document.createElement("div");
    L.className = "det lock";
    L.id = "lock";
    const s = document.createElement("span");
    s.textContent = "R136";
    L.appendChild(s);
    place(L, [T.core[0], T.core[1], 0.035]);
    // Keep the tag on screen: hang it to the left when the core sits near the right edge.
    if (rect.x + T.core[0] * rect.w > hero.clientWidth - 260) L.classList.add("flip");
    if (!instant) { L.style.opacity = "0"; setTimeout(() => { L.style.opacity = ""; L.classList.add("pop"); }, 700 + T.src.length * 16 + 150); }
    box.appendChild(L);
  }

  (async () => {
    img = await loadImage(tarantulaSrc());
    if (!img.naturalWidth) return;
    size();
    addEventListener("resize", size);
    if (reduce) { revealed = 1; size(); detections(true); return; }
    const t0 = performance.now();
    const step = (t: number) => {
      const k = clamp((t - t0) / 900, 0, 1);
      const upto = Math.floor(tiles.length * k * k);
      for (let i = Math.floor(tiles.length * revealed); i < upto; i++) tile(tiles[i]);
      revealed = upto / tiles.length;
      if (k < 1) requestAnimationFrame(step);
      else { revealed = 1; ctx.drawImage(img, rect.x, rect.y, rect.w, rect.h); }
    };
    requestAnimationFrame(step);
    detections(false);
    scramble(hero.querySelector("h1")!);
  })();
</script>
