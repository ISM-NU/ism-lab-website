---
// The central molecular zone with the Planck field at its own resolution and
// the mean field orientation PILOT measured there (Mangilli et al. 2019,
// 2019A&A...630A..74M). Data from src/data/gc-field.json (scripts/render_gc.py).
// The PILOT maps are not drawn: only the published mean orientation.
import gc from "../data/gc-field.json";

const ads = "https://ui.adsabs.harvard.edu/abs/2019A%26A...630A..74M";
const half = (gc.seg_len / 2) * 0.8;
const seg = (x: number, y: number, deg: number, h: number) => {
  const r = (deg * Math.PI) / 180, dx = -Math.sin(r) * h, dy = -Math.cos(r) * h;
  return `M${(x - dx).toFixed(1)},${(y - dy).toFixed(1)}L${(x + dx).toFixed(1)},${(y + dy).toFixed(1)}`;
};
const [px, py] = gc.pilot.centre;
// PILOT line across the frame; label chips sit off the line, and segments
// under a chip are left out so no line runs through text.
const pilotPath = seg(px, py, gc.pilot.a, 430);
const arcR = 230;
const ar = (gc.pilot.a * Math.PI) / 180;
// Arc from the plane (pointing to +l, left) to the PILOT direction (up-left).
const arc = `M${px - arcR},${py}A${arcR},${arcR} 0 0 1 ${(px - Math.sin(ar) * arcR).toFixed(1)},${(py - Math.cos(ar) * arcR).toFixed(1)}`;
const chips = [
  { x: 60, y: 262, w: 300, h: 40 },
  { x: 150, y: 428, w: 110, h: 44 },
];
const free = (s: { x: number; y: number }) => !chips.some((c) => s.x > c.x - 20 && s.x < c.x + c.w + 20 && s.y > c.y - 20 && s.y < c.y + c.h + 20);
const segs = gc.segments.filter(free);

const fovArcmin = gc.fov_deg * 60;
const pcBar = 50;
const barLen = ((pcBar / gc.dist_pc) * (180 / Math.PI) * 60 / fovArcmin) * 1000;
---

<div class="gcf">
  <figure class="map">
    <div class="pic">
      <img src={gc.image_small} srcset={`${gc.image_small} 960w, ${gc.image} 1920w`} sizes="(min-width: 1100px) 820px, 100vw" alt="Multi-band image of the central two degrees of the Milky Way: Herschel 250 and 70 µm dust and Spitzer 8 µm" loading="lazy" decoding="async" />
      <svg viewBox="0 0 1000 1000" role="img" aria-label={`Planck field segments over the central molecular zone, and the PILOT mean field orientation, ${gc.pilot.tilt} degrees clockwise from the Galactic plane`}>
        <g class="segs">{segs.map((s) => <path d={seg(s.x, s.y, s.a, half)} />)}</g>
        <path class="plane" d={`M0,${py}H1000`} />
        <path class="pilot" d={pilotPath} />
        <path class="arc" d={arc} />
        <rect class="chip" x={chips[1].x} y={chips[1].y} width={chips[1].w} height={chips[1].h} />
        <text class="ang" x={chips[1].x + chips[1].w / 2} y={chips[1].y + 32}>{gc.pilot.tilt}°</text>
      </svg>
      <span class="lab red" style={`left:${chips[0].x / 10}%;top:${chips[0].y / 10}%`}>PILOT 240 µm mean field</span>
      <span class="lab plab" style="right:3%;top:calc(50% + 10px)">b = 0</span>
      <div class="mfoot">
        <span class="beam"><svg viewBox="0 0 10 10" style={`width:calc(100cqw * ${((2 * gc.beam_r) / 1000).toFixed(4)})`} aria-hidden="true"><circle cx="5" cy="5" r="4.6" /></svg>Planck {gc.fwhm_arcmin.toFixed(1)}′</span>
        <span class="bar"><i style={`width:calc(100cqw * ${(barLen / 1000).toFixed(4)})`}></i>{pcBar} pc</span>
      </div>
    </div>
    <figcaption class="cap">
      The central 2° of the Milky Way in Galactic coordinates, l increasing to the left. White segments: plane-of-sky field from Planck PR4 353 GHz at its own resolution (about {gc.fwhm_arcmin.toFixed(0)}′), one per beam, where the angle uncertainty is below 10°. Planck integrates the whole line of sight through the disc, so these segments mix the central molecular zone with everything in front of it and behind it. Red line: the mean field orientation PILOT measured at 240 µm and 2.2′ over the full zone, {gc.pilot.tilt}° clockwise from the Galactic plane (<a href={ads}>Mangilli et al. 2019</a>); the PILOT maps themselves are not drawn here. Averaging the Planck Q and U over this frame gives {gc.planck_mean_tilt}°, in line with the paper's finding that the two agree globally.
    </figcaption>
  </figure>

  <aside class="panel" aria-label="PILOT results for the central molecular zone, Mangilli et al. 2019">
    <h3 class="ph">PILOT in the CMZ</h3>
    <dl class="nums">
      <div><dt>Mean field tilt, PILOT</dt><dd>≃ {gc.pilot.tilt}° clockwise</dd></div>
      <div><dt>Planck Q, U averaged here</dt><dd>{gc.planck_mean_tilt}° clockwise</dd></div>
      <div><dt>Map</dt><dd>240 µm, 2.2′, −2° &lt; l &lt; 2°, −4° &lt; b &lt; 3°</dd></div>
    </dl>
    <table>
      <caption>Field strength if magnetic and ram pressure balance</caption>
      <thead><tr><th scope="col">Cloud</th><th scope="col">B (mG)</th></tr></thead>
      <tbody>
        <tr><th scope="row">Sgr B2</th><td>4.7</td></tr>
        <tr><th scope="row">Brick</th><td>1.4</td></tr>
        <tr><th scope="row">50 km/s cloud</th><td>2.7</td></tr>
        <tr><th scope="row">20 km/s cloud</th><td>2.8</td></tr>
      </tbody>
    </table>
    <p class="how">
      The paper finds the 22° tilt only within about −1.5° &lt; l &lt; 1.5°; further out the Planck field turns parallel to the plane. It reconciles the low polarization fraction with the ordered field through a strong field inclined about 15° to the line of sight. Strengths from its Table 1; the field there is taken at 15° to the line of sight and 22° on the sky. <a href={ads}>Mangilli et al. 2019</a>.
    </p>
  </aside>
</div>

<style>
  .gcf { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 340px); gap: 24px; align-items: start; margin-top: 32px; }
  .map { margin: 0; display: grid; gap: 16px; }
  .pic { position: relative; aspect-ratio: 1; background: var(--panel); overflow: hidden; container-type: inline-size; }
  .pic > img, .pic > svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .segs path { stroke: rgba(243, 243, 239, 0.66); stroke-width: 1.2; stroke-linecap: round; fill: none; vector-effect: non-scaling-stroke; }
  .plane { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 2 5; fill: none; opacity: 0.8; vector-effect: non-scaling-stroke; }
  .pilot { stroke: var(--signal); stroke-width: 3; fill: none; vector-effect: non-scaling-stroke; }
  .arc { stroke: var(--signal); stroke-width: 1.4; fill: none; vector-effect: non-scaling-stroke; }
  .chip { fill: rgba(0, 0, 0, 0.78); }
  .ang { fill: var(--signal); font: 600 32px var(--mono); text-anchor: middle; }
  .lab { position: absolute; padding: 4px 8px; background: rgba(0, 0, 0, 0.78); font: 600 12px/1.2 var(--mono); letter-spacing: 0.06em; color: var(--ink); white-space: nowrap; pointer-events: none; }
  .lab.red { color: var(--signal); }
  .mfoot { position: absolute; left: 3%; right: 3%; bottom: 3%; display: flex; justify-content: space-between; align-items: end; gap: 12px; pointer-events: none; }
  .mfoot > span { display: inline-flex; align-items: center; gap: 8px; padding: 4px 8px; background: rgba(0, 0, 0, 0.72); font: 500 12px/1.2 var(--mono); color: var(--ink); }
  .beam svg { min-width: 8px; aspect-ratio: 1; height: auto; overflow: visible; }
  .beam circle { fill: none; stroke: var(--ink); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .bar { flex-direction: column; align-items: stretch !important; gap: 4px !important; text-align: right; min-width: 3em; }
  .bar i { display: block; height: 5px; border: 1px solid var(--ink); border-top: 0; align-self: flex-end; }
  .cap { font-size: 14px; color: var(--grey); max-width: 70ch; margin: 0; }
  .panel { display: grid; gap: 16px; border: 1px solid var(--hair); padding: 16px; }
  .ph { margin: 0; font: 700 18px/1.1 var(--brut); }
  .nums { margin: 0; display: grid; gap: 8px; }
  .nums div { display: grid; gap: 2px; padding-bottom: 8px; border-bottom: 1px solid var(--hair); }
  .nums dt { font: 600 12px/1.3 var(--mono); letter-spacing: 0.06em; color: var(--grey); }
  .nums dd { margin: 0; font: 500 14px/1.4 var(--mono); color: var(--ink); }
  table { border-collapse: collapse; width: 100%; font: 500 14px/1.4 var(--mono); }
  caption { text-align: left; font-size: 14px; color: var(--ink); padding-bottom: 8px; font-family: var(--brut); }
  th, td { text-align: left; padding: 8px 16px 8px 0; border-bottom: 1px solid var(--hair); }
  thead th { font-weight: 600; color: var(--grey); font-size: 12px; letter-spacing: 0.06em; }
  tbody th { font-family: var(--brut); font-weight: 600; font-size: 14px; }
  td { font-variant-numeric: tabular-nums; }
  .how { margin: 0; font-size: 14px; line-height: 1.5; color: var(--grey); }
  @media (max-width: 960px) {
    .gcf { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 480px) {
    .lab, .mfoot > span { font-size: 12px; }
  }
</style>
