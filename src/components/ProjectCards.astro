---
import { getCollection } from "astro:content";
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<div class="proj cells">
  {projects.map((p, i) => (
    <a class="card" href={`/research/${p.id}`}>
      <figure><img src={p.data.image} alt="" loading="lazy" decoding="async" /></figure>
      <div class="meta">
        <div class="row"><span class="dot code">{String(i + 1).padStart(2, "0")}/{p.data.code}</span>{p.data.upcoming.length > 0 && <span class="tag soon">Coming soon</span>}</div>
        <h3 class="brut">{p.data.title}</h3>
        <p>{p.data.summary}</p>
        <span class="label">{p.data.instruments.join(" · ")} &middot; {p.data.papers.length} papers</span>
      </div>
    </a>
  ))}
</div>

<style>
  .proj { grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); margin-top: 40px; }
  .card { display: grid; grid-template-rows: auto 1fr; text-decoration: none; }
  figure { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; background: var(--panel); position: relative; }
  img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s; filter: grayscale(0.35); }
  .card:hover img, .card:focus-visible img { transform: scale(1.05); filter: none; }
  figure::after { content: ""; position: absolute; inset: 0; border: 1px solid var(--signal); opacity: 0; transition: opacity 0.2s; }
  .card:hover figure::after { opacity: 1; }
  .meta { padding: 18px 16px 22px; display: grid; gap: 12px; align-content: start; }
  .row { display: flex; justify-content: space-between; gap: 10px; align-items: center; }
  .code { font-size: 22px; line-height: 1; }
  h3 { font-size: clamp(1.7rem, 1.2rem + 1.2vw, 2.4rem); line-height: 0.9; }
  p { font-size: 13px; color: color-mix(in srgb, currentColor 80%, transparent); }
  @media (prefers-reduced-motion: reduce) { img { transition: none; } }
</style>
