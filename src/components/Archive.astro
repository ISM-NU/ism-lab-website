---
// The group's multi-band composites (scripts/composites.py). Hover, focus or
// tap weaves the Planck field-orientation texture into the image; on touch
// screens, which have no hover, the field layer shows from the start.
import { composites as compCredits, maps } from "../lib/data";
import MapFrame from "./MapFrame.astro";
import facts, { lyLabel, pcToLy } from "../lib/facts";

type Card = { id: keyof typeof compCredits; t: string; sub: string; d: string; href: string; zoom?: number };
// Instruments come from the bands the pipeline actually used (it falls back,
// e.g. to WISE where Spitzer does not cover the field), first word of each credit.
const instruments = (id: keyof typeof compCredits) => [...new Set(compCredits[id].map((c) => c.split(" ")[0]))].join(" · ");
// Scale, compass, beams and the Method drawer come from maps.json (distances
// and their references are cited there). zoom: the LMC composite shares the
// 12 degree analysis grid; the card crops in, and the scale bar accounts for it.
// The field layer is faded where the polarized S/N is below 3 (mask from map_meta.py, written only below the 0.99 used here).
const mask = (id: string) => {
  const k = maps.images[`comp-${id}-field`]?.snr;
  return k && maps.snr_stats[k].frac_gt3 < 0.99 ? `mask-image:url(/sky/snr-${k}.webp);mask-size:100% 100%;mask-mode:luminance;-webkit-mask-image:url(/sky/snr-${k}.webp);-webkit-mask-size:100% 100%;` : "";
};
const cards: Card[] = [
  { id: "lmc", t: "LMC", sub: "Large Magellanic Cloud", d: `${lyLabel(pcToLy(facts.lmc.distance_pc), 3)} ly`, href: "/research/lmc", zoom: 1.45 },
  { id: "galactic_centre", t: "Gal. Centre", sub: "Central molecular zone", d: `${lyLabel(pcToLy(facts.galactic_centre.distance_pc), 2)} ly`, href: "/research/dust-polarization" },
  { id: "monoceros_ob1", t: "Mon OB1", sub: "Star-forming cloud", d: `${lyLabel(pcToLy(facts.mon_ob1.cloud_distance_pc), 2)} ly`, href: "/research/star-formation" },
];
---

<div class="archive cells">
  {cards.map((c) => (
    <article class="card" tabindex="0" aria-label={`${c.sub}: composite of ${instruments(c.id)}, with the Planck field orientation`}>
      <figure style={`--z:${c.zoom ?? 1}`}>
        <MapFrame ids={[`comp-${c.id}`, `comp-${c.id}-field`]} active={[`comp-${c.id}`]} zoom={c.zoom ?? 1}>
        <img loading="lazy" decoding="async" src={`/sky/comp-${c.id}-960.webp`} srcset={`/sky/comp-${c.id}-960.webp 960w, /sky/comp-${c.id}-1920.webp 1920w`} sizes="(max-width: 800px) 100vw, 880px" alt={`${c.sub}, multi-band composite`} />
        <img class="field" loading="lazy" decoding="async" srcset={`/sky/comp-${c.id}-field-960.webp 960w, /sky/comp-${c.id}-field-1920.webp 1920w`} sizes="(max-width: 800px) 100vw, 880px" alt="" style={mask(c.id)} />
        </MapFrame>
        <i class="scan"></i>
      </figure>
      <div class="meta">
        <div class="row"><span class="dot name">{c.t}</span><b>{c.d}</b></div>
        <div class="row"><span>{c.sub}</span></div>
        <div class="row"><span>{instruments(c.id)} &middot; field: Planck 353 GHz</span></div>
        <a class="more" href={c.href}>Research &rarr;</a>
      </div>
    </article>
  ))}
</div>

<style>
  .archive { grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); margin-top: 32px; }
  .card { display: grid; grid-template-rows: auto 1fr; }
  figure { margin: 0; position: relative; overflow: hidden; background: var(--panel); aspect-ratio: 1; }
  /* No hover zoom: the scale bar is a measurement and must stay true. */
  img { width: 100%; height: 100%; object-fit: cover; transform: scale(var(--z)); }
  .field { position: absolute; inset: 0; opacity: 0; transition: opacity 0.9s ease; }
  .card.on .field { opacity: 1; }
  @media (hover: none) { .field { opacity: 1; } }
  @media (min-width: 900px) { .card:first-child { grid-column: span 2; grid-row: span 2; } .card:first-child .name { font-size: 32px; } }
  .scan { position: absolute; left: 0; right: 0; height: 2px; background: var(--signal); box-shadow: 0 0 12px var(--signal); top: -4px; opacity: 0; }
  .card.on .scan { animation: scan 0.7s cubic-bezier(0.6, 0, 0.2, 1) both; }
  @keyframes scan { 0% { top: 0; opacity: 1; } 100% { top: 100%; opacity: 0.2; } }
  .meta { padding: 16px 16px 16px; display: grid; gap: 8px; border-top: 1px solid var(--hair); align-content: start; }
  .name { font-size: 24px; line-height: 1; }
  .row { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font: 500 12px/1.4 var(--mono); color: var(--grey); letter-spacing: 0.06em; text-transform: uppercase; }
  .row b { color: var(--ink); font-weight: 600; }
  .more { font: 600 12px/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; justify-self: start; padding: 8px 0; }
  @media (prefers-reduced-motion: reduce) { .field { transition: none; } .card.on .scan { animation: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".archive .card").forEach((card) => {
    const mf = card.querySelector<HTMLElement>(".mf");
    const base = mf?.dataset.ids?.split(" ") ?? [];
    // The beams and bar follow what is visible: the field layer shows on hover, always on touch.
    const show = (field: boolean) => mf?.dispatchEvent(new CustomEvent("mf:set", { detail: field ? base.slice(1) : base.slice(0, 1) }));
    const touch = matchMedia("(hover: none)").matches;
    if (touch) show(true);
    const on = () => { card.classList.remove("on"); void card.offsetWidth; card.classList.add("on"); show(true); };
    const off = () => { card.classList.remove("on"); show(touch); };
    card.addEventListener("mouseenter", on);
    card.addEventListener("focus", on);
    card.addEventListener("mouseleave", off);
    card.addEventListener("blur", (e) => { if (!card.contains(e.relatedTarget as Node)) off(); });
  });
</script>
